# ---------- build stage ----------
FROM floryn90/hugo:0.152.2-ext-ubuntu-onbuild AS builder

# ONBUILD actions automatically do:
# - COPY . /src
# - WORKDIR /src
# - RUN hugo
#
# Output ends up in: /target

# ---------- runtime stage ----------
FROM nginx:1.27-alpine

# Copy the generated static site
COPY --from=builder /target /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
