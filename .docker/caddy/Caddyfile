    encode gzip
    reverse_proxy pgweb:8081
}

uat-web.uzhv.com {
    encode gzip
    root * /srv/uat-web
    header Content-Security-Policy "default-src 'self'; style-src 'self' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net; script-src 'self'; img-src 'self' data:"
    file_server
}


