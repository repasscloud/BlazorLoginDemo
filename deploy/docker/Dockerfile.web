# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Install Node.js for Tailwind CSS build (required by MSBuild BeforeTargets target)
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm \
    && rm -rf /var/lib/apt/lists/*

COPY Cinturon360.slnx .
COPY Directory.Build.props .
COPY Directory.Packages.props .
COPY src/Cinturon360.Common/Cinturon360.Common.csproj src/Cinturon360.Common/
COPY src/Cinturon360.Contracts/Cinturon360.Contracts.csproj src/Cinturon360.Contracts/
COPY src/Cinturon360.Web/Cinturon360.Web.csproj src/Cinturon360.Web/
# Install npm packages early for layer caching
COPY src/Cinturon360.Web/package.json src/Cinturon360.Web/
RUN cd src/Cinturon360.Web && npm install

RUN dotnet restore src/Cinturon360.Web/Cinturon360.Web.csproj

COPY src/ src/
RUN dotnet publish src/Cinturon360.Web/Cinturon360.Web.csproj \
    -c Release \
    -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

RUN useradd --no-create-home --shell /bin/false appuser
RUN mkdir -p /app/dp-keys && chown appuser /app/dp-keys
USER appuser

COPY --from=build /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Cinturon360.Web.dll"]
