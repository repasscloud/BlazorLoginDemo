# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Cinturon360.slnx .
COPY Directory.Build.props .
COPY Directory.Packages.props .
COPY src/Cinturon360.Common/Cinturon360.Common.csproj src/Cinturon360.Common/
COPY src/Cinturon360.Contracts/Cinturon360.Contracts.csproj src/Cinturon360.Contracts/
COPY src/Cinturon360.Web/Cinturon360.Web.csproj src/Cinturon360.Web/

RUN dotnet restore src/Cinturon360.Web/Cinturon360.Web.csproj

COPY src/ src/
RUN dotnet publish src/Cinturon360.Web/Cinturon360.Web.csproj \
    --no-restore \
    -c Release \
    -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

RUN adduser --disabled-password --gecos "" appuser
USER appuser

COPY --from=build /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Cinturon360.Web.dll"]
