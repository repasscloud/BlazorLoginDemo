@page "/Error"
@using System.Diagnostics

<PageTitle>Error — Cinturon360</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-surface-muted px-4">
    <div class="c-card w-full max-w-md p-8 text-center">
        <div class="mx-auto w-12 h-12 rounded-2xl flex items-center justify-center mb-4"
             style="background:rgba(239,68,68,0.1)">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                 style="color:var(--c-danger)" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>
        <h1 class="font-heading font-semibold text-lg mb-2" style="color:var(--c-text-primary)">
            Something went wrong
        </h1>
        <p class="text-sm mb-4" style="color:var(--c-text-muted)">
            An unexpected error occurred. Please try again or contact support.
        </p>
        @if (ShowRequestId)
        {
            <p class="text-xs font-mono mb-4" style="color:var(--c-text-muted)">
                Request ID: @RequestId
            </p>
        }
        <a href="/" class="c-btn c-btn-primary">Go to home</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}

