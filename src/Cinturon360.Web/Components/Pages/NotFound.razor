@page "/not-found"
@layout MainLayout

<PageTitle>Page not found — Cinturon360</PageTitle>

<div class="c-empty-state">
    <div class="mx-auto w-16 h-16 rounded-2xl flex items-center justify-center mb-4"
         style="background:rgba(56,189,248,0.1)">
        <svg class="w-8 h-8 text-brand-sky" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
    </div>
    <h2 class="font-heading font-semibold text-lg mb-2" style="color:var(--c-text-primary)">
        Page not found
    </h2>
    <p class="text-sm mb-6" style="color:var(--c-text-muted)">
        The page you're looking for doesn't exist or you don't have access to it.
    </p>
    <a href="/" class="c-btn c-btn-primary">Go to home</a>
</div>
