@using Cinturon360.Domain.Enums.Ticketing

@{
    var (bg, text, label) = Status switch
    {
        TicketStatus.Open         => ("rgba(59,130,246,0.12)", "var(--c-brand-sky)", "Open"),
        TicketStatus.InProgress   => ("rgba(234,179,8,0.12)",  "var(--c-warning)",   "In Progress"),
        TicketStatus.AwaitingUser => ("rgba(168,85,247,0.12)", "#a855f7",            "Awaiting You"),
        TicketStatus.Escalated    => ("rgba(249,115,22,0.12)", "#f97316",            "Escalated"),
        TicketStatus.Resolved     => ("rgba(34,197,94,0.12)",  "var(--c-success)",   "Resolved"),
        TicketStatus.Closed       => ("rgba(107,114,128,0.15)","var(--c-text-muted)", "Closed"),
        _                         => ("rgba(107,114,128,0.15)","var(--c-text-muted)", Status.ToString())
    };
}

<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium"
      style="background:@bg;color:@text">@label</span>

@code {
    [Parameter, EditorRequired] public TicketStatus Status { get; set; }
}
