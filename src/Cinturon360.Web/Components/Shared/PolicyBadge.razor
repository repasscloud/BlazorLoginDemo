@* Policy compliance badge *@
<span class="c-badge @BadgeClass" title="@Reason">
    @Label
</span>

@code {
    [Parameter, EditorRequired] public bool IsCompliant { get; set; }
    [Parameter] public string? ViolationReason { get; set; }
    [Parameter] public string? BadgeLabel { get; set; }
    [Parameter] public string? BadgeColour { get; set; }

    private string Label => BadgeLabel
        ?? (IsCompliant ? "In Policy" : "Out of Policy");

    private string BadgeClass => BadgeColour switch
    {
        "success" => "c-badge-success",
        "warning" => "c-badge-warning",
        "danger"  => "c-badge-danger",
        _ => IsCompliant ? "c-badge-success" : "c-badge-danger",
    };

    private string Reason => IsCompliant
        ? "This option complies with your travel policy."
        : ViolationReason ?? "This option is outside your travel policy.";
}
