@* Error boundary wrapper - shows a friendly fallback instead of crashing the whole page *@
@inject NavigationManager Nav

<ErrorBoundary @ref="_boundary">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <ErrorContent Context="ex">
        <div class="c-card p-8 text-center">
            <div class="mx-auto w-12 h-12 rounded-2xl flex items-center justify-center mb-4"
                 style="background:rgba(239,68,68,0.1)">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                     style="color:var(--c-danger)" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <h3 class="text-base font-heading font-semibold mb-2" style="color:var(--c-text-primary)">
                Something went wrong
            </h3>
            <p class="text-sm mb-4" style="color:var(--c-text-muted)">
                An unexpected error occurred on this page. You can try to recover or return home.
            </p>
            <div class="flex gap-3 justify-center flex-wrap">
                <button class="c-btn c-btn-secondary" @onclick="Recover">Try to recover</button>
                <a href="/" class="c-btn c-btn-primary">Go to home</a>
                <button class="c-btn c-btn-secondary" @onclick="() => RaiseTicket(ex)">
                    Raise Support Ticket
                </button>
            </div>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private ErrorBoundary? _boundary;

    private void Recover() => _boundary?.Recover();

    private void RaiseTicket(Exception ex)
    {
        var ctx = System.Text.Json.JsonSerializer.Serialize(new
        {
            page      = Nav.Uri,
            errorType = ex.GetType().Name,
            message   = ex.Message,
            timestamp = DateTimeOffset.UtcNow
        });
        var encodedCtx = Uri.EscapeDataString(ctx);
        var subject    = Uri.EscapeDataString($"Error on {new Uri(Nav.Uri).AbsolutePath}: {ex.Message[..Math.Min(ex.Message.Length, 80)]}");
        Nav.NavigateTo($"/support/raise?subject={subject}&category=6&ctx={encodedCtx}");
    }
}
