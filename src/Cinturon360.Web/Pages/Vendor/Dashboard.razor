@page "/vendor"
@attribute [Authorize]
@rendermode InteractiveServer
@inject OrgApiClient OrgApi
@inject BillingApiClient BillingApi
@inject AuthenticationStateProvider AuthState

<PageTitle>Vendor Dashboard — Cinturon360</PageTitle>

<PageHeader Title="Vendor Dashboard" Subtitle="Organisations and billing overview." />

@if (_loading)
{
    <LoadingSpinner FullPage Label="Loading dashboard…" />
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        <div class="c-card p-5">
            <p class="text-xs font-medium uppercase tracking-wide mb-1" style="color:var(--c-text-muted)">
                Managed Orgs
            </p>
            <p class="text-3xl font-heading font-bold" style="color:var(--c-text-primary)">@_orgCount</p>
        </div>

        <div class="c-card p-5">
            <p class="text-xs font-medium uppercase tracking-wide mb-1" style="color:var(--c-text-muted)">
                License Status
            </p>
            @if (_license is not null)
            {
                <StatusBadge Status="@(_license.IsActive ? "active" : "inactive")" />
                <p class="text-xs mt-1" style="color:var(--c-text-muted)">
                    Expires @(_license.ExpiresOn?.ToString("d MMM yyyy") ?? "Never")
                </p>
            }
        </div>

        <div class="c-card p-5">
            <p class="text-xs font-medium uppercase tracking-wide mb-1" style="color:var(--c-text-muted)">
                Quick links
            </p>
            <div class="flex flex-col gap-1 text-xs">
                <a href="/vendor/organisations" class="text-brand-sky hover:underline">Organisations →</a>
                <a href="/vendor/billing" class="text-brand-sky hover:underline">Billing →</a>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private int _orgCount;
    private Cinturon360.Contracts.Billing.OrgLicenseResponse? _license;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var auth = await AuthState.GetAuthenticationStateAsync();
        var orgId = auth.User.FindFirst(Cinturon360.Web.Security.ClaimTypes.OrgId)?.Value ?? "";

        var orgsTask    = OrgApi.ListOrgsAsync();
        var licenseTask = !string.IsNullOrEmpty(orgId)
            ? BillingApi.GetLicenseAsync(orgId)
            : Task.FromResult(ApiResult<Cinturon360.Contracts.Billing.OrgLicenseResponse>.Fail("no org"));

        await Task.WhenAll(orgsTask, licenseTask);

        var orgsResult = await orgsTask;
        if (orgsResult.IsSuccess && orgsResult.Value is not null)
            _orgCount = orgsResult.Value.Total;

        var licResult = await licenseTask;
        if (licResult.IsSuccess) _license = licResult.Value;

        _loading = false;
        StateHasChanged();
    }
}
