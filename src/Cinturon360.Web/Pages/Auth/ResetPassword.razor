@page "/auth/reset-password"
@layout EmptyLayout
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@inject IdentityApiClient IdentityApi
@inject NavigationManager Nav

<PageTitle>Reset password — Cinturon360</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-surface-muted px-4">
    <div class="w-full max-w-sm">
        <div class="text-center mb-8">
            <span class="c-wordmark text-2xl"><span class="c360">Cinturon</span><span class="c360-num">360</span></span>
            <p class="mt-1 text-sm" style="color:var(--c-text-muted)">Create a new password</p>
        </div>

        <div class="c-card p-8">
            @if (!string.IsNullOrEmpty(Token) && !string.IsNullOrEmpty(Email))
            {
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="mb-4 rounded-xl p-3 text-sm border-l-4 border-red-500"
                         style="color:var(--c-danger)" role="alert">
                        @_errorMessage
                    </div>
                }

                <EditForm Model="_model" OnValidSubmit="HandleResetAsync" FormName="reset-password">
                    <DataAnnotationsValidator />

                    <div class="c-field">
                        <label class="c-label" for="password">New password</label>
                        <InputText id="password" class="c-input" type="password"
                                   @bind-Value="_model.NewPassword"
                                   autocomplete="new-password" />
                        <ValidationMessage For="() => _model.NewPassword" class="c-field-error" />
                    </div>

                    <div class="c-field">
                        <label class="c-label" for="confirm">Confirm new password</label>
                        <InputText id="confirm" class="c-input" type="password"
                                   @bind-Value="_model.ConfirmPassword"
                                   autocomplete="new-password" />
                        <ValidationMessage For="() => _model.ConfirmPassword" class="c-field-error" />
                    </div>

                    <button type="submit" class="c-btn c-btn-primary w-full mt-4" disabled="@_busy">
                        @if (_busy) { <LoadingSpinner Size="sm" Label="" /> }
                        Set new password
                    </button>
                </EditForm>
            }
            else
            {
                <p class="text-sm" style="color:var(--c-danger)">
                    Invalid or expired reset link. Please <a href="/auth/forgot-password"
                    class="underline text-brand-sky">request a new one</a>.
                </p>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }

    private readonly ResetModel _model = new();
    private string? _errorMessage;
    private bool _busy;

    private async Task HandleResetAsync()
    {
        _busy = true;
        _errorMessage = null;

        var result = await IdentityApi.ResetPasswordAsync(new Cinturon360.Contracts.Auth.ResetPasswordRequest(
            Email: Email!,
            Token: Token!,
            NewPassword: _model.NewPassword,
            ConfirmPassword: _model.ConfirmPassword));

        if (!result.IsSuccess)
        {
            _errorMessage = result.Error ?? "Password reset failed. The link may have expired.";
            _busy = false;
            return;
        }

        Nav.NavigateTo("/auth/login?reset=1");
    }

    private sealed class ResetModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "New password is required.")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Password must be at least 8 characters.")]
        public string NewPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please confirm your password.")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
