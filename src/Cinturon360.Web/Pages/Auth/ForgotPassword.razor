@page "/auth/forgot-password"
@layout EmptyLayout
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@inject IdentityApiClient IdentityApi
@inject NavigationManager Nav

<PageTitle>Forgot password — Cinturon360</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-surface-muted px-4">
    <div class="w-full max-w-sm">
        <div class="text-center mb-8">
            <span class="c-wordmark text-2xl"><span class="c360">Cinturon</span><span class="c360-num">360</span></span>
            <p class="mt-1 text-sm" style="color:var(--c-text-muted)">Reset your password</p>
        </div>

        <div class="c-card p-8">
            @if (_sent)
            {
                <div class="text-center">
                    <div class="mx-auto w-12 h-12 rounded-2xl flex items-center justify-center mb-4"
                         style="background:rgba(56,189,248,0.1)">
                        <svg class="w-6 h-6 text-brand-sky" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <h3 class="font-heading font-semibold text-base mb-2" style="color:var(--c-text-primary)">
                        Check your email
                    </h3>
                    <p class="text-sm" style="color:var(--c-text-muted)">
                        If an account exists for <strong>@_sentEmail</strong>, you'll receive a password reset link shortly.
                    </p>
                    <a href="/auth/login" class="c-btn c-btn-primary w-full mt-6 inline-block text-center">
                        Back to sign in
                    </a>
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="mb-4 rounded-xl p-3 text-sm border-l-4 border-red-500"
                         style="color:var(--c-danger)" role="alert">
                        @_errorMessage
                    </div>
                }

                <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync" FormName="forgot-password">
                    <DataAnnotationsValidator />

                    <div class="c-field">
                        <label class="c-label" for="email">Email address</label>
                        <InputText id="email" class="c-input" type="email"
                                   @bind-Value="_model.Email"
                                   placeholder="you@example.com"
                                   autocomplete="email" />
                        <ValidationMessage For="() => _model.Email" class="c-field-error" />
                    </div>

                    <button type="submit" class="c-btn c-btn-primary w-full mt-4" disabled="@_busy">
                        @if (_busy) { <LoadingSpinner Size="sm" Label="" /> }
                        Send reset link
                    </button>
                </EditForm>

                <div class="mt-4 text-center">
                    <a href="/auth/login" class="text-xs font-medium text-brand-sky hover:underline">
                        Back to sign in
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly ForgotModel _model = new();
    private string? _errorMessage;
    private bool _busy;
    private bool _sent;
    private string _sentEmail = "";

    private async Task HandleSubmitAsync()
    {
        _busy = true;
        _errorMessage = null;
        _sentEmail = _model.Email;

        await IdentityApi.RequestPasswordResetAsync(
            new Cinturon360.Contracts.Auth.ForgotPasswordRequest(_model.Email));

        // Always show success to prevent email enumeration
        _sent = true;
        _busy = false;
    }

    private sealed class ForgotModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";
    }
}
