@using Microsoft.AspNetCore.Components;
@page "/auth/login"
@layout EmptyLayout
@rendermode InteractiveServer
@attribute [AllowAnonymous]

<PageTitle>Sign in — Cinturon360</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-surface-muted px-4">
    <div class="w-full max-w-sm">
        <!-- Wordmark -->
        <div class="text-center mb-8">
            <span class="c-wordmark text-2xl"><span class="c360">Cinturon</span><span class="c360-num">360</span></span>
            <p class="mt-1 text-sm" style="color:var(--c-text-muted)">Sign in to your account</p>
        </div>

        <div class="c-card p-8">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mb-4 rounded-xl p-3 text-sm border-l-4 border-red-500 bg-red-50 dark:bg-red-900/20"
                     style="color:var(--c-danger)" role="alert">
                    @_errorMessage
                </div>
            }

            <form method="post" action="/auth/login-handler">
                <AntiforgeryToken />

                <div class="c-field">
                    <label class="c-label" for="email">Email address</label>
                    <input id="email" class="c-input" type="email" name="email"
                               placeholder="you@example.com"
                               autocomplete="email" required />
                </div>

                <div class="c-field">
                    <div class="flex items-center justify-between mb-1">
                        <label class="c-label !mb-0" for="password">Password</label>
                        <a href="/auth/forgot-password"
                           class="text-xs font-medium text-brand-sky hover:underline">
                            Forgot password?
                        </a>
                    </div>
                    <input id="password" class="c-input" type="password" name="password"
                               autocomplete="current-password" />
                </div>

                <button type="submit" class="c-btn c-btn-primary w-full mt-4">
                    Sign in
                </button>
            </form>
        </div>

        <p class="text-center text-sm mt-6" style="color:var(--c-text-muted)">
            Don't have an account?
            <a href="/auth/register" class="font-medium text-brand-sky hover:underline">Create one</a>
        </p>

        <p class="text-center text-xs mt-4" style="color:var(--c-text-muted)">
            © @DateTime.UtcNow.Year Cinturon360. All rights reserved.
        </p>
    </div>
</div>

@code {
    private string? _errorMessage;

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    protected override void OnInitialized()
    {
        if (Error == "invalid_credentials")
        {
            _errorMessage = "Invalid email or password. Please try again.";
        }
    }
}
