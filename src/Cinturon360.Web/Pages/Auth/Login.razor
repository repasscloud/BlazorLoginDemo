@page "/auth/login"
@layout EmptyLayout
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@inject IdentityApiClient IdentityApi
@inject UserSessionService SessionService
@inject NavigationManager Nav

<PageTitle>Sign in — Cinturon360</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-surface-muted px-4">
    <div class="w-full max-w-sm">
        <!-- Wordmark -->
        <div class="text-center mb-8">
            <span class="c-wordmark text-2xl"><span class="c360">Cinturon</span><span class="c360-num">360</span></span>
            <p class="mt-1 text-sm" style="color:var(--c-text-muted)">Sign in to your account</p>
        </div>

        <div class="c-card p-8">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mb-4 rounded-xl p-3 text-sm border-l-4 border-red-500 bg-red-50 dark:bg-red-900/20"
                     style="color:var(--c-danger)" role="alert">
                    @_errorMessage
                </div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleLoginAsync" FormName="login">
                <DataAnnotationsValidator />

                <div class="c-field">
                    <label class="c-label" for="email">Email address</label>
                    <InputText id="email" class="c-input" type="email"
                               @bind-Value="_model.Email"
                               placeholder="you@example.com"
                               autocomplete="email" />
                    <ValidationMessage For="() => _model.Email" class="c-field-error" />
                </div>

                <div class="c-field">
                    <div class="flex items-center justify-between mb-1">
                        <label class="c-label !mb-0" for="password">Password</label>
                        <a href="/auth/forgot-password"
                           class="text-xs font-medium text-brand-sky hover:underline">
                            Forgot password?
                        </a>
                    </div>
                    <InputText id="password" class="c-input" type="password"
                               @bind-Value="_model.Password"
                               autocomplete="current-password" />
                    <ValidationMessage For="() => _model.Password" class="c-field-error" />
                </div>

                <button type="submit" class="c-btn c-btn-primary w-full mt-4" disabled="@_busy">
                    @if (_busy)
                    {
                        <LoadingSpinner Size="sm" Label="" />
                    }
                    Sign in
                </button>
            </EditForm>
        </div>

        <p class="text-center text-xs mt-6" style="color:var(--c-text-muted)">
            © @DateTime.UtcNow.Year Cinturon360. All rights reserved.
        </p>
    </div>
</div>

@code {
    private readonly LoginModel _model = new();
    private string? _errorMessage;
    private bool _busy;

    private async Task HandleLoginAsync()
    {
        _busy = true;
        _errorMessage = null;

        var result = await IdentityApi.LoginAsync(
            new Cinturon360.Contracts.Auth.LoginRequest(_model.Email, _model.Password));

        if (!result.IsSuccess)
        {
            _errorMessage = result.Error ?? "Sign in failed. Please check your credentials.";
            _busy = false;
            return;
        }

        var loginResponse = result.Value!;

        if (loginResponse.RequiresMfa)
        {
            Nav.NavigateTo($"/auth/mfa?session={Uri.EscapeDataString(loginResponse.SessionId ?? "")}");
            return;
        }

        var user = loginResponse.User!;
        await SessionService.SignInAsync(
            userId:        user.UserId,
            orgId:         user.OrgId ?? "",
            email:         user.Email,
            displayName:   user.FullName,
            userCategory:  user.UserCategory ?? "Client",
            platformRole:  user.PlatformRole ?? "User",
            accessToken:   loginResponse.AccessToken!,
            refreshToken:  loginResponse.RefreshToken ?? "",
            tokenExpiry:   loginResponse.ExpiresAt ?? DateTimeOffset.UtcNow.AddHours(1));

        Nav.NavigateTo("/");
        _busy = false;
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = "";
    }
}
