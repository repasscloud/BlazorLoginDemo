@page "/auth/logout"
@layout EmptyLayout
@rendermode InteractiveServer
@inject UserSessionService SessionService
@inject NavigationManager Nav

<PageTitle>Signing out… — Cinturon360</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-surface-muted">
    <LoadingSpinner Label="Signing you out…" Size="lg" />
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await SessionService.SignOutAsync();
        Nav.NavigateTo("/auth/login", forceLoad: true);
    }
}
