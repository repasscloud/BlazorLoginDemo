@page "/sudo/documents"
@attribute [Authorize]
@rendermode InteractiveServer
@inject SystemApiClient SystemApi

<PageTitle>Stored Documents — Cinturon360</PageTitle>

<PageHeader Title="Stored Documents" Subtitle="All files and documents managed by the platform." />

@if (_loading)
{
    <LoadingSpinner FullPage Label="Loading documents…" />
}
else if (_error is not null)
{
    <div class="c-card p-6 text-center">
        <p class="text-sm" style="color:var(--c-danger)">@_error</p>
        <button class="c-btn c-btn-secondary mt-4" @onclick="LoadAsync">Retry</button>
    </div>
}
else if (_documents.Count == 0)
{
    <div class="c-empty-state">
        <p class="text-sm" style="color:var(--c-text-muted)">No stored documents found.</p>
    </div>
}
else
{
    <div class="c-card overflow-hidden">
        <table class="c-table">
            <thead>
                <tr>
                    <th>File name</th>
                    <th>Type</th>
                    <th>Size</th>
                    <th>Visibility</th>
                    <th>Created</th>
                    <th>Expires</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in _documents)
                {
                    <tr>
                        <td class="font-medium" style="color:var(--c-text-primary)">@doc.FileName</td>
                        <td class="text-xs" style="color:var(--c-text-muted)">@(doc.ContentType ?? "—")</td>
                        <td class="text-xs">@FormatBytes(doc.FileSizeBytes)</td>
                        <td>
                            <StatusBadge Status="@(doc.IsPublic ? "public" : "private")" />
                        </td>
                        <td class="text-xs" style="color:var(--c-text-muted)">
                            @doc.CreatedAt.ToString("d MMM yyyy")
                        </td>
                        <td class="text-xs" style="color:var(--c-text-muted)">
                            @(doc.ExpiresAt?.ToString("d MMM yyyy") ?? "Never")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<Cinturon360.Contracts.System.StoredDocumentResponse> _documents = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        var result = await SystemApi.ListDocumentsAsync();
        if (result.IsSuccess && result.Value is not null)
            _documents = result.Value.Items.ToList();
        else
            _error = result.Error ?? "Failed to load documents.";

        _loading = false;
        StateHasChanged();
    }

    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024         => $"{bytes} B",
        < 1024 * 1024  => $"{bytes / 1024.0:F1} KB",
        _              => $"{bytes / (1024.0 * 1024):F1} MB",
    };
}
