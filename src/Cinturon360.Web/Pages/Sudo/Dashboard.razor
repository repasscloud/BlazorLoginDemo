@page "/sudo"
@attribute [Authorize]
@rendermode InteractiveServer
@inject OrgApiClient OrgApi
@inject SystemApiClient SystemApi

<PageTitle>Platform Dashboard — Cinturon360</PageTitle>

<PageHeader Title="Platform Dashboard" Subtitle="System health and operational overview." />

@if (_loading)
{
    <LoadingSpinner FullPage Label="Loading dashboard…" />
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        <div class="c-card p-5">
            <p class="text-xs font-medium uppercase tracking-wide mb-1" style="color:var(--c-text-muted)">
                Total Orgs
            </p>
            <p class="text-3xl font-heading font-bold" style="color:var(--c-text-primary)">@_orgCount</p>
        </div>
        <div class="c-card p-5">
            <p class="text-xs font-medium uppercase tracking-wide mb-1" style="color:var(--c-text-muted)">
                Jobs Today
            </p>
            <p class="text-3xl font-heading font-bold" style="color:var(--c-text-primary)">@_jobCount</p>
        </div>
        <div class="c-card p-5">
            <p class="text-xs font-medium uppercase tracking-wide mb-1" style="color:var(--c-text-muted)">
                Quick links
            </p>
            <div class="flex flex-col gap-1 text-xs">
                <a href="/sudo/users"  class="text-brand-sky hover:underline">Users →</a>
                <a href="/sudo/jobs"   class="text-brand-sky hover:underline">Job Queue →</a>
                <a href="/sudo/audit"  class="text-brand-sky hover:underline">Audit Log →</a>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private int _orgCount;
    private int _jobCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var orgsTask = OrgApi.ListOrgsAsync();
        var jobsTask = SystemApi.ListJobsAsync(page: 1, pageSize: 1);
        await Task.WhenAll(orgsTask, jobsTask);

        var orgsResult = await orgsTask;
        if (orgsResult.IsSuccess && orgsResult.Value is not null)
            _orgCount = orgsResult.Value.Total;

        var jobsResult = await jobsTask;
        if (jobsResult.IsSuccess && jobsResult.Value is not null)
            _jobCount = jobsResult.Value.Total;

        _loading = false;
        StateHasChanged();
    }
}
