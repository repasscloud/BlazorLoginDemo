@page "/settings/security"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Security Settings — Cinturon360</PageTitle>

<PageHeader Title="Security" Subtitle="Password, MFA, and active sessions." />

<div class="c-card p-6 max-w-lg">
    <div class="mb-6">
        <h2 class="text-sm font-heading font-semibold mb-2" style="color:var(--c-text-primary)">
            Password
        </h2>
        <p class="text-sm mb-4" style="color:var(--c-text-muted)">
            Use a strong, unique password for your account.
        </p>
        <a href="/auth/forgot-password" class="c-btn c-btn-secondary">
            Change password
        </a>
    </div>

    <hr style="border-color:var(--c-border)" class="my-4" />

    <div class="mb-6">
        <h2 class="text-sm font-heading font-semibold mb-2" style="color:var(--c-text-primary)">
            Two-Factor Authentication
        </h2>
        <p class="text-sm mb-4" style="color:var(--c-text-muted)">
            Protect your account with a TOTP authenticator app.
        </p>
        <button class="c-btn c-btn-secondary">Set up 2FA</button>
    </div>

    <hr style="border-color:var(--c-border)" class="my-4" />

    <div class="mb-6">
        <h2 class="text-sm font-heading font-semibold mb-2" style="color:var(--c-text-primary)">
            Personal Access Tokens
        </h2>
        <p class="text-sm mb-4" style="color:var(--c-text-muted)">
            Create and revoke API tokens for scripts and developer tooling.
        </p>
        <a href="/settings/personal-access-tokens" class="c-btn c-btn-secondary">
            Manage tokens
        </a>
    </div>

    <hr style="border-color:var(--c-border)" class="my-4" />

    <div>
        <h2 class="text-sm font-heading font-semibold mb-2" style="color:var(--c-text-primary)">
            Sign out everywhere
        </h2>
        <p class="text-sm mb-4" style="color:var(--c-text-muted)">
            View and manage your active sessions across devices.
        </p>
        <a href="/settings/sessions" class="c-btn c-btn-secondary">
            Manage sessions
        </a>
    </div>
</div>
