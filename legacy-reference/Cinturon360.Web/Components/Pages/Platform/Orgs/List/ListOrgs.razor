@page "/platform/orgs"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPolicies.PlatformPolicy.AdminArea)]

@using System.Security.Claims
@using Cinturon360.Shared.Auth
@using Cinturon360.Web.Exceptions
@using Cinturon360.Web.Infrastructure.Http
@using Cinturon360.Web.ViewModels.Orgs
@using static Cinturon360.Shared.Contracts.Organizations.OrganizationUnifiedDto

@inject AuthenticationStateProvider AuthStateProvider
@inject C360ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Orgs</PageTitle>

@if (_vm is null || _vm.IsLoading)
{
    <Cinturon360.Web.Components.Shared.LoadingOverlay
        Message="Loading organizations…"
        RequestId="_vm?.Rid" />
}
else if (_vm.Error is not null)
{
    <Cinturon360.Web.Components.Shared.ErrorPanel
        Message="_vm.Error"
        RequestId="_vm.Rid"
        OnRetry="ReloadAsync"
        OnLogSupport="LogSupportAsync" />
}
else
{
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Organizations</h2>

        <button class="btn btn-primary"
                @onclick="NewOrganization">
            New Organization
        </button>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <input class="form-control"
                   placeholder="Search organizations..."
                   @oninput="OnSearchChanged" />
        </div>
    </div>

    <div class="small text-muted mb-2">
        Showing @FilteredOrgs.Count() of @_vm.Orgs.Count
    </div>

    @if (!FilteredOrgs.Any())
    {
        <div class="alert alert-info">
            No organizations match your search.
        </div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Sector</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (OrgListItemVm o in FilteredOrgs)
                {
                    <tr>
                        <td>@o.OrgName</td>
                        <td>@o.OrgType</td>
                        <td>@o.OrgSector</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => ViewOrganization(o.Id)">
                                View
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {

    [Parameter, EditorRequired]
    public string OrgId { get; set; } = default!;

    private ListOrgsVm? _vm;

    private string _search = string.Empty;
    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        string? rid = RequestIdFactory.Create();

        _vm = ListOrgsVm.Loading(rid);

        StateHasChanged();

        try
        {
            AuthenticationState auth =
                await AuthStateProvider.GetAuthenticationStateAsync();

            ClaimsPrincipal user = auth.User;

            string userId =
                user.FindFirstValue(ClaimTypes.NameIdentifier)
                ?? throw new InvalidOperationException(message: "UserId missing");

            ListOrganizationItemsAggregate? response =
                await Api.Organization.GetOrganizationsAsync(rid: rid);

            if (response is null)
            {
                _vm = ListOrgsVm.Failed(
                    error: "No response from server",
                    rid);
            }
            else
            {
                _vm = ListOrgsMapper.ToVm(
                    response,
                    rid);
            }
        }
        catch (ApiException ex)
        {
            _vm = ListOrgsVm.Failed(
                ex.Message,
                rid);
        }
        catch (Exception ex)
        {
            _vm = ListOrgsVm.Failed(
                error: $"An unexpected error occurred: {ex.Message}",
                rid: rid);
        }

        StateHasChanged();
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();

        CancellationToken token = _searchCts.Token;

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(1), token);

            _search = e.Value?.ToString() ?? string.Empty;

            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // expected when user continues typing
        }
    }

    private IEnumerable<OrgListItemVm> FilteredOrgs =>
        string.IsNullOrWhiteSpace(_search)
            ? _vm?.Orgs ?? Enumerable.Empty<OrgListItemVm>()
            : (_vm?.Orgs ?? Enumerable.Empty<OrgListItemVm>())
                .Where(o => MatchesSearch(o, _search));

    private static bool MatchesSearch(OrgListItemVm o, string search)
    {
        var s = search.Trim();

        return
            Contains(o.OrgName, s) ||
            Contains(o.TaxRegistrationNumber, s) ||
            Contains(o.AddressLine1, s) ||
            Contains(o.City, s) ||
            Contains(o.MailingAddressLine1, s) ||
            Contains(o.MailingCity, s) ||
            Contains(o.ContactPersonLastName, s) ||
            Contains(o.ContactPersonPhone, s) ||
            Contains(o.ContactPersonEmail, s) ||
            Contains(o.BillingPersonLastName, s) ||
            Contains(o.BillingPersonPhone, s) ||
            Contains(o.BillingPersonEmail, s) ||
            Contains(o.AdminPersonLastName, s) ||
            Contains(o.AdminPersonPhone, s) ||
            Contains(o.AdminPersonEmail, s) ||
            Contains(o.OrgType.ToString(), s) ||
            Contains(o.OrgSector.ToString(), s);
    }

    private static bool Contains(string? source, string value) =>
        !string.IsNullOrWhiteSpace(source) &&
        source.Contains(value, StringComparison.OrdinalIgnoreCase);

    private void NewOrganization()
        => Navigation.NavigateTo("/platform/org/new");

    private void ViewOrganization(string organizationId)
        => Navigation.NavigateTo($"/platform/org/{organizationId}/view");

    private Task LogSupportAsync()
        => Task.CompletedTask;
}