@page "/not-authorized"
@attribute [AllowAnonymous]

<PageTitle>Access denied</PageTitle>

<main class="container d-flex align-items-center justify-content-center"
      style="min-height: 100vh;">
    <div class="col-md-7 col-lg-6">

        <div class="card shadow-sm border-danger">
            <div class="card-body text-center p-4">

                <div class="mb-3 text-danger">
                    <i class="bi bi-shield-lock-fill fs-1"></i>
                </div>

                <h1 class="h4 mb-2">Access denied</h1>

                <p class="text-muted mb-3">
                    You’re signed in, but your account doesn’t have permission to
                    access this area.
                </p>

                <div class="mono text-muted mb-4">
                    HTTP 403 · Policy restricted
                </div>

                <div class="alert alert-light text-start small mb-4">
                    <strong>What you can do:</strong>
                    <ul class="mb-0">
                        <li>Return to your dashboard</li>
                        <li>Contact an administrator for access</li>
                        <li>Log a support request if you believe this is an error</li>
                    </ul>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a href="/" class="btn btn-outline-secondary">
                        Back to dashboard
                    </a>
                    <button class="btn btn-danger" @onclick="LogSupport">
                        Log support request
                    </button>
                </div>

            </div>
        </div>

    </div>
</main>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private void LogSupport()
    {
        // Adjust route when your support flow is finalised
        Navigation.NavigateTo("/support/new");
    }
}
