@using Microsoft.AspNetCore.Components.Authorization
@using Cinturon360.Web.Components.Account.Shared

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView
            RouteData="routeData"
            DefaultLayout="typeof(Layout.MainLayout)">

            <Authorizing>
                <Cinturon360.Web.Components.Shared.LoadingOverlay Message="Checking permissions…" />
            </Authorizing>

            <NotAuthorized>
                <NotAuthorizedRouter />
            </NotAuthorized>

        </AuthorizeRouteView>

        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>

    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <Cinturon360.Web.Components.Pages.NotFound />
        </LayoutView>
    </NotFound>
</Router>
