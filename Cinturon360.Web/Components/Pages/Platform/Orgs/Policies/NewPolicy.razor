@page "/platform/organizations/{OrgId}/edit"
@using Cinturon360.Shared.Models.Static.Billing
@using Cinturon360.Shared.Models.Static.Travel
@using Cinturon360.Web.Infrastructure.Http
@using System.Security.Claims
@using Cinturon360.Shared.Contracts.Geography
@using Cinturon360.Web.ViewModels.ReferenceData
@rendermode InteractiveServer

@inject AuthenticationStateProvider AuthStateProvider
@inject C360ApiClient Api
@inject NavigationManager Navigation

<PageTitle>New Travel Policy</PageTitle>

@if (_vm is null || _vm.IsLoading)
{
    <LoadingOverlay />
}
else if (_vm.Error is not null)
{
    <ErrorPanel
        Message="_vm.Error"
        RequestId="_vm.Rid"
        OnRetry="ReloadAsync"
        OnLogSupport="LogSupportAsync" />

}
else
{
    <!-- existing UI style goes here -->
}

@code {
    [Parameter, EditorRequired]
    public string OrgId { get; set; } = default!;

    private NewTravelPolicyVm? _vm;

    protected override async Task OnInitializedAsync()
    {
        string? rid = RequestIdFactory.Create();

        try
        {
            AuthenticationState? state = await AuthStateProvider.GetAuthenticationStateAsync();
            System.Security.Claims.ClaimsPrincipal? user = state.User;
            string? userId = user.FindFirstValue(ClaimTypes.NameIdentifier)
                ?? throw new InvalidOperationException("UserId missing");

            _vm = new NewTravelPolicyVm
            {
                Rid = rid,
                OrgId = OrgId,
                UserId = userId,
                IsLoading = true
            };

            // Currency reference data
            CurrencyReference? currencyRef = new CurrencyReference
            {
                Options = Currencies.All
                    .Select(c => new CurrencyOption(
                        Code: c.Code,
                        DisplayName: $"{c.Name} ({c.LetterSymbol})"
                    ))
                    .ToList()
            };

            // Geography reference data
            GeographyUnifiedDto.GeographyAggregate? aggregate = await Api.Geography.GetAggregateAsync(rid);
            GeographyReference? geographyRef = new GeographyReference
            {
                Regions = aggregate.Regions,
                Continents = aggregate.Continents,
                Countries = aggregate.Countries
            };

            // FareType reference data
            FareTypeReference? fareTypeRef = new FareTypeReference
            {
                Options = FareType.All
                    .Select(f => new FareTypeOption(
                        Type: f.Type,
                        DisplayName: f.Label
                    ))
                    .ToList()
            };

            // CabinClass reference data
            CabinClassCoverageReference? cabinClassCoverageRef = new CabinClassCoverageReference
            {
                Options = CabinClassCoverages.All
                    .Select(c => new CabinClassCoverageOption(
                        Type: c.Type,
                        DisplayName: c.Label,
                        Description: c.Description
                    ))
                    .ToList()
            };

            // HotelRoomType reference data
            HotelRoomTypeReference? hotelRoomTypeRef = new HotelRoomTypeReference
            {
                Options = HotelRoomType.All
                    .Select(r => new HotelRoomTypeOption(
                        Type: r.Type,
                        DisplayName: r.Label
                    ))
                    .ToList()
            };

            // RailClass reference data
            RailClassReference? railClassRef = new RailClassReference
            {
                Options = RailFareType.All
                    .Select(f => new RailClassOption(
                        Type: f.Type,
                        DisplayName: f.Label
                    ))
                    .ToList()
            };

            // HireCar reference data
            AcrissReference? acrissRef = new AcrissReference
            {
                Categories = AcrissType.CategoryOptions
                    .Select(o => new AcrissOption(o.code, o.label))
                    .ToList(),

                Bodies = AcrissType.BodyOptions
                    .Select(o => new AcrissOption(o.code, o.label))
                    .ToList(),

                Transmissions = AcrissType.TransmissionOptions
                    .Select(o => new AcrissOption(o.code, o.label))
                    .ToList(),

                Fuels = AcrissType.FuelOptions
                    .Select(o => new AcrissOption(o.code, o.label))
                    .ToList()
            };

            _vm = _vm with
            {
                CurrencyRef = currencyRef,
                GeographyRef = geographyRef,
                FareTypeRef = fareTypeRef,
                CabinClassCoverageRef = cabinClassCoverageRef,
                HotelRoomTypeRef = hotelRoomTypeRef,
                RailClassRef = railClassRef,
                AcrissRef = acrissRef,
            };
        }
        catch (Exception ex)
        {
            _vm = new NewTravelPolicyVm
            {
                Rid = rid,
                OrgId = OrgId,
                UserId = string.Empty,
                IsLoading = false,
                Error = ex.Message
            };
        }
    }

        private async Task ReloadAsync()
    {
        _vm = _vm with { IsLoading = true };
        await OnInitializedAsync();
    }

    private void LogSupportAsync()
    {
        Navigation.NavigateTo(
            $"/support/new?rid={_vm.Rid}&page=NewTravelPolicy");
    }

}
