@page "/platform/org/{OrgId}/policies/travel/new"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPolicies.PlatformPolicy.AdminArea)]
@* @attribute [Authorize(Policy = "Platform:ManageUsers")] *@

@using System.Security.Claims
@using Cinturon360.Shared.Auth
@using Cinturon360.Shared.Models.Static.Billing
@using Cinturon360.Shared.Models.Static.Travel
@using Cinturon360.Shared.Models.Static.Travel.Acriss
@using Cinturon360.Shared.Models.Travel.Rail.Entities
@using Cinturon360.Web.Drafts.Platform.Orgs.Policies.Travel
@using Cinturon360.Web.Exceptions
@using Cinturon360.Web.Infrastructure.Http
@using Cinturon360.Shared.Contracts.Geography
@using Cinturon360.Web.ViewModels.ReferenceData
@using Cinturon360.Web.ViewModels.Policies.Travel
@using Org.BouncyCastle.Crypto.Engines

@inject AuthenticationStateProvider AuthStateProvider
@inject C360ApiClient Api
@inject NavigationManager Navigation

<PageTitle>New Travel Policy</PageTitle>

@if (_vm is null || _vm.IsLoading)
{
    <Cinturon360.Web.Components.Shared.LoadingOverlay
        Message="Preparing travel policy configuration…"
        RequestId="_vm.Rid" />

}
else if (_vm.Error is not null)
{
    <Cinturon360.Web.Components.Shared.ErrorPanel
        Message="_vm.Error"
        RequestId="_vm.Rid"
        OnRetry="ReloadAsync"
        OnLogSupport="LogSupportAsync" />
}
else
{
    <!-- existing UI style goes here -->
    <EditForm EditContext="_editCtx" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <Microsoft.AspNetCore.Components.Forms.ValidationSummary />

        <!-- default page header -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="mb-0">New Travel Policy</h2>

            <div class="btn-group">
                <button class="btn btn-outline-secondary"
                        type="button"
                        @onclick="Cancel">
                    Cancel
                </button>

                <button type="submit"
                        class="btn btn-primary">
                    Save
                </button>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header">
                <small class="text-muted">[ORG_NAME]</small>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Policy Name</label>
                        <InputText class="form-control"
                                   @bind-Value="_draft.PolicyName" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Policy Currency</label>
                        <InputSelect class="form-select"
                                     @bind-Value="_draft.DefaultCurrencyCode">
                            @foreach (CurrencyOption option in _vm.CurrencyRef.Options)
                            {
                                <option value="@option.Code">@option.DisplayName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Org Id</label>
                        <InputText class="form-control bg-light" @bind-Value="_draft.OrgId" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- Geographic Scope -->
        <div class="card shadow-sm mb-3">
            <div class="card-header"><h6 class="mb-0">Geographic Scope</h6></div>
            <div class="card-body">
                <div class="row g-3">

                    <!-- Regions -->
                    <div class="col-md-4">
                        <label class="form-label">Enabled Regions</label>

                        <InputSelect class="form-select"
                                     multiple
                                     size="8"
                                     @bind-Value="_draft.RegionIds">
                            @foreach (Cinturon360.Shared.Models.Geography.Region r in _vm.GeographyRef.Regions)
                            {
                                <option value="@r.Id">@r.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <!-- Continents -->
                    <div class="col-md-4">
                        <label class="form-label">Enabled Continents</label>
                        <InputSelect class="form-select"
                                     multiple
                                     size="8"
                                     @bind-Value="_draft.ContinentIds">
                            @foreach (Cinturon360.Shared.Models.Geography.Continent c in _vm.GeographyRef.Continents)
                            {
                                <option value="@c.Id.ToString()">@c.Name (@c.IsoCode)</option>
                            }
                        </InputSelect>
                    </div>

                    <!-- Countries -->
                    <div class="col-md-4">
                        <label class="form-label">Enabled Countries</label>
                        <InputSelect class="form-select" multiple size="8" @bind-Value="_draft.CountryIds">
                            @foreach (Cinturon360.Shared.Models.Geography.Country c in _vm.GeographyRef.Countries)
                            {
                                <option value="@c.Id.ToString()">@c.Name (@c.IsoCode)</option>
                            }
                        </InputSelect>
                        <div class="form-text">These are allowed even if a continent/region is not selected.</div>
                    </div>

                    <!-- Disabled Countries -->
                    <div class="col-md-12">
                        <label class="form-label">Disabled Countries</label>
                        <InputSelect class="form-select" multiple size="8" @bind-Value="_draft.DisabledCountryIds">
                            @foreach (Cinturon360.Shared.Models.Geography.Country c in _vm.GeographyRef.Countries)
                            {
                                <option value="@c.Id.ToString()">@c.Name (@c.IsoCode)</option>
                            }
                        </InputSelect>
                        <div class="form-text">Disabled overrides any enablement above.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Flights -->
        <div class="card shadow-sm mb-3">
            <div class="card-header"><h6 class="mb-0">Flights</h6></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Max Flight Price</label>
                        <InputNumber class="form-control" @bind-Value="_draft.MaxFlightPrice" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Default Seating</label>
                        <InputSelect class="form-select" @bind-Value="_draft.DefaultFlightSeating">
                            @foreach ((string Code, string Label) c in FareType.DropdownOptions)
                            {
                                <option value="@c.Code">@c.Label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Max Seating</label>
                        <InputSelect class="form-select" @bind-Value="_draft.MaxFlightSeating">
                            @foreach ((string Code, string Label) c in FareType.DropdownOptions)
                            {
                                <option value="@c.Code">@c.Label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Non-Stop only</label>
                        <div class="form-check form-switch mt-2">
                            <InputCheckbox class="form-check-input" @bind-Value="_draft.NonStopFlight" />
                            <label class="form-check-label" title="@(_draft.NonStopFlight ? "Required" : "Optional")">
                                <span aria-hidden="true">@(_draft.NonStopFlight ? " ✅" : " ❌")</span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Included Airline Codes</label>

                        <div class="border rounded p-2"
                            style="max-height: 260px; overflow-y: auto;">

                            @foreach (var a in _vm.AirlineRef!.Options)
                            {
                                <div class="form-check d-flex align-items-center gap-2 mb-1">
                                    <input class="form-check-input"
                                        type="checkbox"
                                        checked="@_draft.IncludedAirlineCodes.Contains(a.Code)"
                                        @onchange="e => ToggleAirline(a.Code, (bool)e.Value!)" />

                                    <img src="@a.LogoUrl"
                                        alt="@a.Code"
                                        style="height:20px;width:auto;" />

                                    <label class="form-check-label">
                                        @a.Code @a.Name
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="form-text">
                            Select zero or more airlines.
                        </div>
                    </div>

                    
                    <div class="col-md-6">
                        <label class="form-label">Excluded Airline Codes</label>

                        <div class="border rounded p-2"
                            style="max-height: 260px; overflow-y: auto;">

                            @foreach (var a in _vm.AirlineRef!.Options)
                            {
                                <div class="form-check d-flex align-items-center gap-2 mb-1">
                                    <input class="form-check-input"
                                        type="checkbox"
                                        checked="@_draft.ExcludedAirlineCodes.Contains(a.Code)"
                                        @onchange="e => ToggleAirline(a.Code, (bool)e.Value!)" />

                                    <img src="@a.LogoUrl"
                                        alt="@a.Code"
                                        style="height:20px;width:auto;" />

                                    <label class="form-check-label">
                                        @a.Code @a.Name
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="form-text">
                            Select zero or more airlines.
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Max Seat at ≥6h</label>
                        <InputSelect class="form-select" @bind-Value="_draft.MaxFlightSeatingAt6Hours">
                            @foreach ((string Code, string Label) c in FareType.DropdownOptions)
                            {
                                <option value="@c.Code">@c.Label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Max Seat at ≥8h</label>
                        <InputSelect class="form-select" @bind-Value="_draft.MaxFlightSeatingAt8Hours">
                            @foreach ((string Code, string Label) c in FareType.DropdownOptions)
                            {
                                <option value="@c.Code">@c.Label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Max Seat at ≥10h</label>
                        <InputSelect class="form-select" @bind-Value="_draft.MaxFlightSeatingAt10Hours">
                            @foreach ((string Code, string Label) c in FareType.DropdownOptions)
                            {
                                <option value="@c.Code">@c.Label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Max Seat at ≥14h</label>
                        <InputSelect class="form-select" @bind-Value="_draft.MaxFlightSeatingAt14Hours">
                            @foreach ((string Code, string Label) c in FareType.DropdownOptions)
                            {
                                <option value="@c.Code">@c.Label</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Max Price ≥6h</label>
                        <InputNumber class="form-control" @bind-Value="_draft.MaxFlightPriceAt6Hours" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Max Price ≥8h</label>
                        <InputNumber class="form-control" @bind-Value="_draft.MaxFlightPriceAt8Hours" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Max Price ≥10h</label>
                        <InputNumber class="form-control" @bind-Value="_draft.MaxFlightPriceAt10Hours" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Max Price ≥14h</label>
                        <InputNumber class="form-control" @bind-Value="_draft.MaxFlightPriceAt14Hours" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Hotels -->
                <div class="card shadow-sm mb-3">
            <div class="card-header"><h6 class="mb-0">Accommodation</h6></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Max Nightly Rate</label>
                        <InputNumber class="form-control" @bind-Value="_draft.MaxHotelNightlyRate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Default Room Type</label>
                        <InputSelect class="form-select" @bind-Value="_draft.DefaultHotelRoomType">
                            @foreach ((string code, string label) c in HotelRoomType.DropdownOptions)
                            {
                                <option value="@c.code">@c.label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Max Room Type</label>
                        <InputSelect class="form-select" @bind-Value="_draft.MaxHotelRoomType">
                            @foreach ((string code, string label) c in HotelRoomType.DropdownOptions)
                            {
                                <option value="@c.code">@c.label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Included Hotel Chains (CSV)</label>
                        <textarea class="form-control" rows="3" @bind="_draft.IncludedHotelChains"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Excluded Hotel Chains (CSV)</label>
                        <textarea class="form-control" rows="3" @bind="_draft.ExcludedHotelChains"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- HIRE CAR -->
        <div class="card shadow-sm mb-3">
            <div class="card-header"><h6 class="mb-0">Hire Car</h6></div>
            <div class="card-body">

                <!-- Default Car -->
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Default Category</label>
                        <InputSelect class="form-select" @bind-Value="_draft.DefaultCarCategory">
                            @foreach (AcrissOption opt in _vm.AcrissRef.Categories)
                            {
                                <option value="@opt.Code">@opt.DisplayName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Default Type (Body)</label>
                        <InputSelect class="form-select" @bind-Value="_draft.DefaultCarBody">
                            @foreach (AcrissOption opt in _vm.AcrissRef.Bodies)
                            {
                                <option value="@opt.Code">@opt.DisplayName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Default Transmission</label>
                        <InputSelect class="form-select" @bind-Value="_draft.DefaultCarTransmission">
                            @foreach (AcrissOption opt in _vm.AcrissRef.Transmissions)
                            {
                                <option value="@opt.Code">@opt.DisplayName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Default Fuel</label>
                        <InputSelect class="form-select" @bind-Value="_draft.DefaultCarFuel">
                            @foreach (AcrissOption opt in _vm.AcrissRef.Fuels)
                            {
                                <option value="@opt.Code">@opt.DisplayName</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <!-- Max Car -->
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Max Category</label>
                        <InputSelect class="form-select" @bind-Value="_draft.MaxCarCategory">
                            @foreach (AcrissOption opt in _vm.AcrissRef.Categories)
                            {
                                <option value="@opt.Code">@opt.DisplayName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Max Type (Body)</label>
                        <InputSelect class="form-select" @bind-Value="_draft.MaxCarBody">
                            @foreach (AcrissOption opt in _vm.AcrissRef.Bodies)
                            {
                                <option value="@opt.Code">@opt.DisplayName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Max Transmission</label>
                        <InputSelect class="form-select" @bind-Value="_draft.MaxCarTransmission">
                            @foreach (AcrissOption opt in _vm.AcrissRef.Transmissions)
                            {
                                <option value="@opt.Code">@opt.DisplayName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Max Fuel</label>
                        <InputSelect class="form-select" @bind-Value="_draft.MaxCarFuel">
                            @foreach (AcrissOption opt in _vm.AcrissRef.Fuels)
                            {
                                <option value="@opt.Code">@opt.DisplayName</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Default Car Class</label>
                        <InputText class="form-control bg-light" Value="@DefaultCarClass" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Max Car Class</label>
                        <InputText class="form-control bg-light" Value="@MaxCarClass" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- RAIL -->
        <div class="card shadow-sm mb-3">
            <div class="card-header"><h6 class="mb-0">Rail</h6></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label">Max Train Class</label>
                        <InputSelect id="railfareMaxChoice" class="form-select" @bind-Value="_draft.MaxTrainClass">
                            @foreach ((string code, string label) c in FareType.DropdownOptions)
                            {
                                <option value="@c.code">@c.label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Max Train Price</label>
                        <InputNumber class="form-control" @bind-Value="_draft.MaxTrainPrice" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Enabled Rail Operators</label>

                        <div class="border rounded p-2"
                            style="max-height: 260px; overflow-y: auto;">

                            @foreach (var a in _vm.RailOperatorRef!.Options)
                            {
                                <div class="form-check d-flex align-items-center gap-2 mb-1">
                                    <input class="form-check-input"
                                        type="checkbox"
                                        checked="@_draft.IncludedRailOperators.Contains(a.Code)"
                                        @onchange="e => ToggleRailOperator(a.Code, (bool)e.Value!)" />

                                    <img src="@a.LogoUrl"
                                        alt="@a.Code"
                                        style="height:20px;width:auto;" />

                                    <label class="form-check-label">
                                        @a.Code @a.Name
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="form-text">
                            Select zero or more rail operators.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Excluded Rail Operators</label>

                        <div class="border rounded p-2"
                            style="max-height: 260px; overflow-y: auto;">

                            @foreach (var a in _vm.RailOperatorRef!.Options)
                            {
                                <div class="form-check d-flex align-items-center gap-2 mb-1">
                                    <input class="form-check-input"
                                        type="checkbox"
                                        checked="@_draft.ExcludedRailOperators.Contains(a.Code)"
                                        @onchange="e => ToggleRailOperator(a.Code, (bool)e.Value!)" />

                                    <img src="@a.LogoUrl"
                                        alt="@a.Code"
                                        style="height:20px;width:auto;" />

                                    <label class="form-check-label">
                                        @a.Code @a.Name
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="form-text">
                            Select zero or more rail operators.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- APPROVALS -->
        <div class="card shadow-sm mb-3">
            <div class="card-header"><h6 class="mb-0">Approvals</h6></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Auto-approve up to policy limit</label>
                        <div class="form-check form-switch mt-2">
                            <InputCheckbox class="form-check-input" @bind-Value="_draft.AutoApproveToPolicyLimit" />
                            <label class="form-check-label" title="@(_draft.AutoApproveToPolicyLimit ? "Auto-Approve To Policy Limit Active" : "Auto-Approve To Policy Limit Inactive")">
                                <span aria-hidden="true">@(_draft.AutoApproveToPolicyLimit ? " ✅" : " ❌")</span>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Require manager approval to limit</label>
                        <div class="form-check form-switch mt-2">
                            <InputCheckbox class="form-check-input" @bind-Value="_draft.RequireManagerApprovalToPolicyLimit" />
                            <label class="form-check-label" title="@(_draft.RequireManagerApprovalToPolicyLimit ? "Manager Approval To Policy Limit Active" : "Manager Approval To Policy Limit Inactive")">
                                <span aria-hidden="true">@(_draft.RequireManagerApprovalToPolicyLimit ? " ✅" : " ❌")</span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Billing Contact to Limit Approval</label>
                        <div class="form-check form-switch mt-2">
                            <InputCheckbox class="form-check-input" @bind-Value="_draft.OrgBillingContactApprovalToPolicyLimit" />
                            <label class="form-check-label" title="@(_draft.OrgBillingContactApprovalToPolicyLimit ? "Billing Contact To Limit Approval Active" : "Billing Contact To Limit Approval Inactive")">
                                <span aria-hidden="true">@(_draft.OrgBillingContactApprovalToPolicyLimit ? " ✅" : " ❌")</span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Billing Contact Above Limit Approval</label>
                        <div class="form-check form-switch mt-2">
                            <InputCheckbox class="form-check-input" @bind-Value="_draft.OrgBillingContactApprovalAbovePolicyLimit" />
                            <label class="form-check-label" title="@(_draft.OrgBillingContactApprovalAbovePolicyLimit ? "Billing Contact Above Limit Approval Active" : "Billing Contact Above Limit Approval Inactive")">
                                <span aria-hidden="true">@(_draft.OrgBillingContactApprovalAbovePolicyLimit ? " ✅" : " ❌")</span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label mb-1">L1 Approval Required</label>
                        <div class="d-flex align-items-center gap-2 flex-nowrap">
                            <!-- switch -->
                            <div class="form-check form-switch m-0">
                                <InputCheckbox class="form-check-input" @bind-Value="_draft.L1ApprovalRequired" />
                            </div>
                            <!-- green tick / red x -->
                            <span class="ms-1" title="@(_draft.L1ApprovalRequired ? "L1 Approval Required" : "L1 Approval Not Required")">
                                @(_draft.L1ApprovalRequired ? "✅" : "❌")
                            </span>
                            <!-- amount -->
                            <div class="input-group input-group-sm flex-grow-1">
                                <span class="input-group-text">$</span>
                                <InputNumber @bind-Value="_draft.L1ApprovalAmount"
                                            class="form-control"
                                            placeholder="L1 amount"
                                            disabled="@(!_draft.L1ApprovalRequired)" />
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label mb-1">L2 Approval Required</label>
                        <div class="d-flex align-items-center gap-2 flex-nowrap">
                            <!-- switch -->
                            <div class="form-check form-switch m-0">
                                <InputCheckbox class="form-check-input" @bind-Value="_draft.L2ApprovalRequired" />
                            </div>
                            <!-- green tick / red x -->
                            <span class="ms-1" title="@(_draft.L2ApprovalRequired ? "L2 Approval Required" : "L2 Approval Not Required")">
                                @(_draft.L2ApprovalRequired ? "✅" : "❌")
                            </span>
                            <!-- amount -->
                            <div class="input-group input-group-sm flex-grow-1">
                                <span class="input-group-text">$</span>
                                <InputNumber @bind-Value="_draft.L2ApprovalAmount"
                                            class="form-control"
                                            placeholder="L2 amount"
                                            disabled="@(!_draft.L2ApprovalRequired)" />
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label mb-1">L3 Approval Required</label>
                        <div class="d-flex align-items-center gap-2 flex-nowrap">
                            <!-- switch -->
                            <div class="form-check form-switch m-0">
                                <InputCheckbox class="form-check-input" @bind-Value="_draft.L3ApprovalRequired" />
                            </div>
                            <!-- green tick / red x -->
                            <span class="ms-1" title="@(_draft.L3ApprovalRequired ? "L3 Approval Required" : "L3 Approval Not Required")">
                                @(_draft.L3ApprovalRequired ? "✅" : "❌")
                            </span>
                            <!-- amount -->
                            <div class="input-group input-group-sm flex-grow-1">
                                <span class="input-group-text">$</span>
                                <InputNumber @bind-Value="_draft.L3ApprovalAmount"
                                            class="form-control"
                                            placeholder="L3 amount"
                                            disabled="@(!_draft.L3ApprovalRequired)" />
                            </div>
                        </div>
                    </div>
                </div>
