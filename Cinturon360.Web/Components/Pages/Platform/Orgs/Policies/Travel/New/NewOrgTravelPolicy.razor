                        Code: c.Code,
                        DisplayName: $"{c.Name} ({c.LetterSymbol})"
                    ))
                    .ToList()
            };

            GeographyUnifiedDto.GeographyAggregate? aggregate = await Api.Geography.GetAggregateAsync(rid);
            GeographyReference? geographyRef = new GeographyReference
            {
                Regions = aggregate.Regions,
                Continents = aggregate.Continents,
                Countries = aggregate.Countries
            };

            FareTypeReference? fareTypeRef = new FareTypeReference
            {
                Options = FareType.All
                    .Select(f => new FareTypeOption(
