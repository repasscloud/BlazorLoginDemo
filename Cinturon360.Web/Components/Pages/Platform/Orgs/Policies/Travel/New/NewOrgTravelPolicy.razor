@page "/platform/org/{OrgId}/policies/travel/new"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPolicies.PlatformPolicy.AdminArea)]
@* @attribute [Authorize(Policy = "Platform:ManageUsers")] *@

@using System.Security.Claims
@using Cinturon360.Shared.Auth
@using Cinturon360.Shared.Models.Static.Billing
@using Cinturon360.Shared.Models.Static.Travel
@using Cinturon360.Shared.Models.Static.Travel.Acriss
@using Cinturon360.Web.Drafts.Platform.Org.Policies.Travel
@using Cinturon360.Web.Exceptions
@using Cinturon360.Web.Infrastructure.Http
@using Cinturon360.Shared.Contracts.Geography
@using Cinturon360.Web.ViewModels.ReferenceData
@using Cinturon360.Web.ViewModels.Policies.Travel
@using Org.BouncyCastle.Crypto.Engines

@inject AuthenticationStateProvider AuthStateProvider
@inject C360ApiClient Api
@inject NavigationManager Navigation

<PageTitle>New Travel Policy</PageTitle>

@if (_vm is null || _vm.IsLoading)
{
    <Cinturon360.Web.Components.Shared.LoadingOverlay
        Message="Preparing travel policy configuration…"
        RequestId="_vm.Rid" />

}
else if (_vm.Error is not null)
{
    <Cinturon360.Web.Components.Shared.ErrorPanel
        Message="_vm.Error"
        RequestId="_vm.Rid"
        OnRetry="ReloadAsync"
        OnLogSupport="LogSupportAsync" />
}
else
{
    <!-- existing UI style goes here -->
    <EditForm EditContext="_editCtx" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Example field -->
        <div class="mb-3">
            <label class="form-label">Policy name</label>
            <InputText class="form-control"
                    @bind-Value="_draft.PolicyName" />
        </div>

        <button type="submit" class="btn btn-primary">
            Save
        </button>
    </EditForm>
}

@code {
    [Parameter, EditorRequired]
    public string OrgId { get; set; } = default!;

    private NewOrgTravelPolicyDraft _draft = default!;
    private EditContext _editCtx = default!;
    private NewTravelPolicyVm? _vm;

    protected override async Task OnInitializedAsync()
    {
        string? rid = RequestIdFactory.Create();

        try
        {
            AuthenticationState? auth = await AuthStateProvider.GetAuthenticationStateAsync();
            ClaimsPrincipal? user = auth.User;
            string? userId = user.FindFirstValue(ClaimTypes.NameIdentifier)
                ?? throw new InvalidOperationException("UserId missing");

            // build the draft with safe defaults
            _draft = new NewOrgTravelPolicyDraft
            {
                OrgId = OrgId,
                EffectiveFromUtc = DateTime.UtcNow.Date
            };

            // create EditContext ONCE
            _editCtx = new EditContext(_draft);

            // Optional: hook validation events later if needed
            // _editCtx.OnValidationRequested += ...
            // _editCtx.OnFieldChanged += ...

            // load reference data
            CurrencyReference? currencyRef = new CurrencyReference
            {
                Options = Currencies.All
                    .Select(c => new CurrencyOption(
                        Code: c.Code,
                        DisplayName: $"{c.Name} ({c.LetterSymbol})"
                    ))
                    .ToList()
            };

            GeographyUnifiedDto.GeographyAggregate? aggregate = await Api.Geography.GetAggregateAsync(rid);
            GeographyReference? geographyRef = new GeographyReference
            {
                Regions = aggregate.Regions,
                Continents = aggregate.Continents,
                Countries = aggregate.Countries
            };

            FareTypeReference? fareTypeRef = new FareTypeReference
            {
                Options = FareType.All
                    .Select(f => new FareTypeOption(
                        Type: f.Type,
                        DisplayName: f.Label
                    ))
                    .ToList()
            };

            CabinClassCoverageReference? cabinClassCoverageRef = new CabinClassCoverageReference
            {
                Options = CabinClassCoverages.All
                    .Select(c => new CabinClassCoverageOption(
                        Type: c.Type,
                        DisplayName: c.Label,
                        Description: c.Description
                    ))
                    .ToList()
            };

            HotelRoomTypeReference? hotelRoomTypeRef = new HotelRoomTypeReference
            {
                Options = HotelRoomType.All
                    .Select(r => new HotelRoomTypeOption(
                        Type: r.Type,
                        DisplayName: r.Label
                    ))
                    .ToList()
            };

            RailClassReference? railClassRef = new RailClassReference
            {
                Options = RailFareType.All
                    .Select(f => new RailClassOption(
                        Type: f.Type,
                        DisplayName: f.Label
                    ))
                    .ToList()
            };

            AcrissReference? acrissRef = new()
            {
                Categories = AcrissCategories.All
                    .Select(c => new AcrissOption(
                        c.Code,
                        c.CodeUpper,
                        c.Label))
                    .ToList(),

                Bodies = AcrissBodies.All
                    .Select(b => new AcrissOption(
                        b.Code,
                        b.CodeUpper,
                        b.Label))
                    .ToList(),

                Transmissions = AcrissTransmissions.All
                    .Select(t => new AcrissOption(
                        t.Code,
                        t.CodeUpper,
                        t.Label))
                    .ToList(),

                Fuels = AcrissFuels.All
                    .Select(f => new AcrissOption(
                        f.Code,
                        f.CodeUpper,
                        f.Label))
                    .ToList()
            };

            _vm = new NewTravelPolicyVm
            {
                Rid = rid,
                OrgId = OrgId,
                UserId = userId,
                IsLoading = true,

                CurrencyRef = currencyRef,
                GeographyRef = geographyRef,
                FareTypeRef = fareTypeRef,
                CabinClassCoverageRef = cabinClassCoverageRef,
                HotelRoomTypeRef = hotelRoomTypeRef,
                RailClassRef = railClassRef,
                AcrissRef = acrissRef
            };
        }
        catch (Exception ex)
        {
            _vm = new NewTravelPolicyVm
            {
                Rid = rid,
                OrgId = OrgId,
                UserId = string.Empty,
                IsLoading = false,
                Error = ex.Message
            };
        }
    }

    private async Task ReloadAsync()
    {
        _vm = _vm! with { IsLoading = true };
        await OnInitializedAsync();
    }

    private async Task SaveAsync()
    {
        if (!_editCtx.Validate())
        {
            return;
        }

        _vm = _vm! with { IsLoading = true, Error = null };

        try
        {
            // map draft to DTO
            var request = MapToRequest(_draft);

            // call API
            await Api.TravelPolicy.CreateAsync(
                rid: _vm!.Rid,
                request
            );

            // navigate on success
            Navigation.NavigateTo(
                uri: $"/platform/org/{OrgId}/policies");
        }
        catch (ApiException apiEx)
        {
            _vm = _vm! with
            {
                Error = $"API Error: {apiEx.Message}",
                IsLoading = false
            };
        }
    }

    private void LogSupportAsync()
    {
        Navigation.NavigateTo(
            uri: $"/support/new?rid={_vm?.Rid}&page=NewTravelPolicy");
    }

    private object MapToRequest(NewOrgTravelPolicyDraft draft)
    {
        // TODO: Replace with your actual request DTO type
        return new
        {
            OrgId = draft.OrgId,
            PolicyName = draft.PolicyName,
            EffectiveFromUtc = draft.EffectiveFromUtc
            // Add other properties as needed
        };
    }

}
