                    .Select(f => new AcrissOption(
                        f.Code,
                        f.CodeUpper,
                        f.Label))
                    .ToList()
            };

            AirlineReference? airlineRef = new AirlineReference
            {
                Options = (await Api.AirlineDataProvider.GetAirlinesAsync(rid))
                    .Airlines
                    .Select(a => new AirlineOption(
                        Code: a.IataCode,
                        Name: a.Name,
                        LogoUrl: a.LogoLockupUrl 
                                ?? "/img/airlines/placeholder.svg"
                    ))
                    .ToList()
            };

            RailOperatorReference? railOperatorRef = new RailOperatorReference
            {
                Options = (await Api.RailDataProvider.GetRailOperatorsAsync(rid))
                .RailOperators
                .Select(r => new RailOperatorOption(
                    Code: r.OperatorId,
                    Name: r.Name,
                    LogoUrl: r.LogoSymbolUrl ?? "/img/railoperators/placeholder.svg"))
