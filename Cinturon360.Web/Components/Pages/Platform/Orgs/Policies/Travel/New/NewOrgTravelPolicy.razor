        catch (Exception ex)
        {
            _vm = new NewTravelPolicyVm
            {
                Rid = rid,
                OrgId = OrgId,
                UserId = string.Empty,
                IsLoading = false,
                Error = ex.Message
            };
        }
    }

    private async Task ReloadAsync()
    {
        _vm = _vm! with { IsLoading = true };
        await OnInitializedAsync();
    }

    private async Task SaveAsync()
    {
        if (!_editCtx.Validate())
        {
            return;
        }

        _vm = _vm! with { IsLoading = true, Error = null };

        try
        {
            // map draft to DTO
            var request = MapToRequest(_draft);

            // call API
            await Api.TravelPolicy.CreateAsync(
                rid: _vm!.Rid,
                request
            );

            // navigate on success
            Navigation.NavigateTo(
                uri: $"/platform/org/{OrgId}/policies");
        }
        catch (ApiException apiEx)
        {
            _vm = _vm! with
            {
                Error = $"API Error: {apiEx.Message}",
                IsLoading = false
            };
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo(
            uri: $"/platform/org/{OrgId}/policies");
    }

    private void LogSupportAsync()
    {
        Navigation.NavigateTo(
            uri: $"/support/new?rid={_vm?.Rid}&page=NewTravelPolicy");
    }

    private object MapToRequest(NewOrgTravelPolicyDraft draft)
    {
        // TODO: Replace with your actual request DTO type
        return new
        {
            OrgId = draft.OrgId,
            PolicyName = draft.PolicyName,
            EffectiveFromUtc = draft.EffectiveFromUtc
            // Add other properties as needed
        };
    }

    // update airline code lists based on checkbox changes - this is a bit manual since we want to support two separate lists (included vs excluded) with checkboxes, but it keeps the UI responsive without needing to wait for API calls
    private void ToggleAirline(string code, bool isChecked)
    {
        if (isChecked)
        {
            if (!_draft.IncludedAirlineCodes.Contains(code))
                _draft.IncludedAirlineCodes.Add(code);
        }
        else
        {
            _draft.IncludedAirlineCodes.Remove(code);
        }
    }

    private void ToggleRailOperator(string code, bool isChecked)
    {
        if (isChecked)
        {
            if (!_draft.IncludedRailOperators.Contains(code))
                _draft.IncludedRailOperators.Add(code);
        }
        else
        {
            _draft.IncludedRailOperators.Remove(code);
        }
    }

    // ===== MBAR values are concatenated strings of the 4 car attributes, so we can compute them on the fly for display or API submission
    private string DefaultCarClass =>
    $"{_draft.DefaultCarCategory}{_draft.DefaultCarBody}{_draft.DefaultCarTransmission}{_draft.DefaultCarFuel}";

    private string MaxCarClass =>
        $"{_draft.MaxCarCategory}{_draft.MaxCarBody}{_draft.MaxCarTransmission}{_draft.MaxCarFuel}";

    
    // ===== Travel Policy Start Date End Date Helper
    private bool _expiresManuallyEdited;

    private static DateTime AsUtcMidnight(DateTime d)
        => new DateTime(d.Year, d.Month, d.Day, hour: 0, minute: 0, second: 0, DateTimeKind.Utc);

    private Task OnEffectiveChanged(DateTime newValue)
    {
        _draft.EffectiveFromUtc = AsUtcMidnight(newValue);

        if (!_expiresManuallyEdited)
            _draft.EffectiveToUtc = _draft.EffectiveFromUtc.AddYears(value: 1);

        return Task.CompletedTask;
    }

    private Task OnExpiresChanged(DateTime newValue)
    {
        _expiresManuallyEdited = true;
        _draft.EffectiveToUtc = AsUtcMidnight(newValue);
        return Task.CompletedTask;
    }
