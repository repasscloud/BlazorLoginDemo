@page "/platform/org/{OrgId}/policies/travel"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPolicies.PlatformPolicy.AdminArea)]

@using System.Security.Claims
@using Cinturon360.Shared.Auth
@using Cinturon360.Web.Exceptions
@using Cinturon360.Web.Infrastructure.Http
@using Cinturon360.Web.ViewModels.Policies.Travel

@inject AuthenticationStateProvider AuthStateProvider
@inject C360ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Travel Policies</PageTitle>

@if (_vm is null || _vm.IsLoading)
{
    <Cinturon360.Web.Components.Shared.LoadingOverlay
        Message="Loading travel policies…"
        RequestId="_vm?.Rid" />
}
else if (_vm.Error is not null)
{
    <Cinturon360.Web.Components.Shared.ErrorPanel
        Message="_vm.Error"
        RequestId="_vm.Rid"
        OnRetry="ReloadAsync"
        OnLogSupport="LogSupportAsync" />
}
else
{
    <div class="d-flex align-items-center justify-content-between mb-3">

        <h2 class="mb-0">Travel Policies</h2>

        <button class="btn btn-primary"
                @onclick="NewPolicy">
            New Policy
        </button>

    </div>

    @if (_vm.Policies.Count == 0)
    {
        <div class="alert alert-info">
            No travel policies exist for this organisation.
        </div>
    }
    else
    {
        <table class="table table-hover">

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Effective From</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (TravelPolicyListItemVm p in _vm.Policies)
                {
                    <tr>

                        <td>@p.Name</td>

                        <td>@p.EffectiveFromUtc.ToString("yyyy-MM-dd")</td>

                        <td>@p.Status</td>

                        <td class="text-end">

                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => EditPolicy(p.Id)">
                                Edit
                            </button>

                        </td>

                    </tr>
                }
            </tbody>

        </table>
    }
}

@code {

    [Parameter, EditorRequired]
    public string OrgId { get; set; } = default!;

    private ListOrgTravelPoliciesVm? _vm;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        string? rid = RequestIdFactory.Create();

        _vm = ListOrgTravelPoliciesVm.Loading(rid);

        StateHasChanged();

        try
        {
            // Optional: access authenticated user (for logging / debugging only)
            AuthenticationState auth =
                await AuthStateProvider.GetAuthenticationStateAsync();

            ClaimsPrincipal user = auth.User;

            string userId =
                user.FindFirstValue(ClaimTypes.NameIdentifier)
                ?? throw new InvalidOperationException("UserId missing");

            // call API
            var response = 
                await Api.TravelPolicy.GetPoliciesAsync(
                    rid: rid,
                    orgId: OrgId);
                
            if (response is null)
            {
                _vm = 
                    ListOrgTravelPoliciesVm.Failed(
                        "No response from server",
                        rid);
            }
            else
            {
                // correct mapper usage
                _vm = 
                    ListOrgTravelPoliciesMapper.ToVm(
                        response,
                        rid);
            }
        }
        catch (ApiException ex)
        {
            _vm =
                ListOrgTravelPoliciesVm.Failed(
                    ex.Message,
                    rid);
        }
        catch (Exception ex)
        {
            _vm =
                ListOrgTravelPoliciesVm.Failed(
                    error: $"An unexpected error occurred: {ex.Message}",
                    rid: rid);
        }

        StateHasChanged();
    }

    private void NewPolicy()
    {
        Navigation.NavigateTo(
            uri: $"/platform/org/{OrgId}/policies/travel/new");
    }

    private void EditPolicy(string travelPolicyId)
    {
        Navigation.NavigateTo(
            uri: $"/platform/org/{OrgId}/policies/travel/{travelPolicyId}/edit");
    }

    private Task LogSupportAsync() 
        => Task.CompletedTask;
}