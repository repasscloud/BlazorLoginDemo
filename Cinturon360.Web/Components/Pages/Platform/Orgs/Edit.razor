@page "/platform/organizations/{OrgId}/edit"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPolicies.PlatformPolicy.AdminArea)]

@using Cinturon360.Shared.Auth
@using Cinturon360.Shared.Models.Kernel.Billing
@using Cinturon360.Shared.Models.Kernel.Platform
@using Cinturon360.Shared.Models.Static.Geography
@using Cinturon360.Shared.Models.Static.Identity
@using Cinturon360.Shared.Models.Static.Platform
@using Cinturon360.Shared.Models.Static.System.SysVar
@using Cinturon360.Shared.Services.Interfaces.Kernel
@using Cinturon360.Shared.Services.Interfaces.Platform
@using Cinturon360.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using System.Reflection;
@using System.Security.Claims;
@using System.Text.Json;
@using System.Text.Json.Serialization;

@inject AuthenticationStateProvider AuthStateProvider
@inject IAdminOrgServiceUnified OrgSvc
@inject IAdminLicenseAgreementServiceUnified LicenseService
@inject NavigationManager Nav
@inject ILoggerService _log
@inject IJSRuntime JS

<EditForm Model="_vm.Organization" OnValidSubmit="@(async () => await SaveAsync(true))">
    <DataAnnotationsValidator />
    <Microsoft.AspNetCore.Components.Forms.ValidationSummary />

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @_error
        </div>
    }

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Edit Organization</h2>
        <div class="btn-group">
            <button type="button" class="btn btn-outline-secondary" @onclick="GoBack">Back</button>
            <button type="submit" class="btn btn-primary">
                @if (_isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Save
            </button>
        </div>
    </div>

  <!-- Identity -->
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span>Identity</span>

            <button
                type="button"
                class="btn btn-sm btn-outline-secondary"
                @onclick="ToggleIdentityReadOnly">
                @if (_isIdentityReadOnly)
                {
                    <span>Edit</span>
                }
                else
                {
                    <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                }
            </button>
        </div>

        <div class="card-body row g-3">
            <div class="col-md-3">
                <label class="form-label">Id</label>
                <div class="input-group">
                    <InputText class="form-control bg-light" Value="_vm.Organization.Id" readonly />
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => CopyToClipboardAsync(_vm.Organization.Id)">
                        <i class="bi bi-clipboard"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Name</label>
                <InputText
                    class="@($"form-control {(_isIdentityReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.Name"
                    readonly="@_isIdentityReadOnly">
                </InputText>
            </div>

            <div class="col-md-2">
                <label class="form-label">Type</label>
                <InputSelect
                    class="@($"form-select {(_isIdentityReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.Type"
                    disabled="@_isIdentityReadOnly">
                    @foreach (OrganizationType t in Enum.GetValues<OrganizationType>())
                    {
                        <option value="@t">@t</option>
                    }
                </InputSelect>
            </div>

            <div class="col-md-1">
                <label class="form-label">@(_vm.Organization.IsActive ? "Active" : "Inactive")</label>
                <div class="form-check form-switch mt-2">
                    <InputCheckbox
                        class="form-check-input"
                        @bind-Value="_vm.Organization.IsActive"
                        disabled="@_isIdentityReadOnly" />
                    <label class="form-check-label" title="@(_vm.Organization.IsActive ? "Active" : "Inactive")">
                        <span aria-hidden="true">@(_vm.Organization.IsActive ? " ✅" : " ❌")</span>
                    </label>
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label">Parent Organization Id</label>
                <div class="input-group">
                    <InputText class="form-control bg-light" @bind-Value="_vm.Organization.ParentOrganizationId" placeholder="Select a parent organization…" readonly />
                    <button type="button" class="btn btn-outline-secondary" title="Pick Parent Organization" @onclick="OpenParentPickerAsync">
                        <i class="bi bi-card-list"></i>
                    </button>
                </div>
                @* optional helper text showing the picked org name *@
                @* @if (!string.IsNullOrWhiteSpace(_parentOrgDisplay))
                {
                    <small class="text-muted">Selected: @_parentOrgDisplay</small>
                } *@
            </div>


            <div class="col-md-6">
                <label class="form-label">Parent</label>
                <input class="form-control bg-light" value="@(parentOrgName ?? "(none)")" readonly />
            </div>

            <!-- TODO: Link fields in OrgEdit page #25 -->
            <div class="col-md-2">
                <label class="form-label">Type</label>
                <input class="form-control bg-light" value="@(parentOrgType)" readonly />
            </div>

            <!-- TODO: Link fields in OrgEdit page #25 -->
            <div class="col-md-1">
                <label class="form-label">@(_vm.Organization.IsActive ? "Active" : "Inactive")</label>
                <div class="form-check form-switch mt-2">
                    <input type="checkbox" class="form-check-input" checked="@(parentOrgActive)" disabled />
                    <label class="form-check-label">
                        <span aria-hidden="true">@(parentOrgActive ? " ✅" : " ❌")</span>
                    </label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label">Children</label>
                <ul class="list-group">
                    @if (_vm.Organization.Children?.Any() == true)
                    {
                        @foreach (var c in _vm.Organization.Children)
                        {
                            <li class="list-group-item d-flex align-items-center">
                                <div class="d-flex align-items-center flex-wrap gap-2">
                                    <span>@c.Name</span>

                                    <!-- Status: green Active / red Disabled -->
                                    <span class="badge rounded-pill @(c.IsActive ? "text-bg-success" : "text-bg-danger")">
                                        @(c.IsActive ? "Active" : "Disabled")
                                    </span>

                                    <!-- Country: white on black -->
                                    @if (Enum.IsDefined(typeof(PassportCountry), c.Country))
                                    {
                                        <span class="badge rounded-pill text-bg-dark">
                                            @c.Country.GetDisplayName()
                                        </span>
                                    }

                                    <!-- TaxId: show only if present, info color -->
                                    @if (!string.IsNullOrWhiteSpace(c.TaxId))
                                    {
                                        <span class="badge rounded-pill text-bg-info">TaxId: @c.TaxId</span>
                                    }
                                </div>

                                <div class="ms-auto d-flex align-items-center gap-2">
                                    <span class="text-muted small">@c.Id</span>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            title="Open org"
                                            @onclick="(() => GoToChildOrgById(c.Id))">
                                        <i class="bi bi-building-gear"></i>
                                    </button>
                                </div>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-muted">No child organizations.</li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Company Defaults -->
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span>Company Defaults</span>

            <button
                type="button"
                class="btn btn-sm btn-outline-secondary"
                @onclick="ToggleCompanyDefaultsReadOnly">
                @if (_isCompanyDefaultsReadOnly)
                {
                    <span>Edit</span>
                }
                else
                {
                    <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                }
            </button>
        </div>
        <div class="card-body row g-3">
            <div class="col-md-2">
                <label class="form-label" for="defaultCurrency">Billing Currency</label>
                <InputSelect
                    id="defaultCurrency"
                    class="@($"form-select {(_isCompanyDefaultsReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.DefaultCurrency"
                    disabled="@_isCompanyDefaultsReadOnly">
                    @foreach (CurrencyOption c in _currencyOptions)
                    {
                        <option value="@c.Code">@c.Code @c.Flag</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="taxIdType">Tax ID Type</label>
                <InputSelect
                    id="taxIdType"
                    class="@($"form-select {(_isCompanyDefaultsReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.TaxIdType"
                    disabled="@_isCompanyDefaultsReadOnly">
                    @foreach (string t in _taxIdOptions)
                    {
                        <option value="@t">@t</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-3">
                <label class="form-label">Tax Id</label>
                <div class="input-group">
                    <InputText
                        class="@($"form-control {(_isCompanyDefaultsReadOnly ? "bg-light" : "")}")"
                        @bind-Value="_vm.Organization.TaxId"
                        readonly="@_isCompanyDefaultsReadOnly">
                    </InputText>

                    <button
                        type="button"
                        class="btn btn-outline-secondary"
                        disabled="@_isCompanyDefaultsReadOnly"
                        @onclick="() => ValidateTaxIdAsync(_vm.Organization.Id, _vm.Organization.TaxIdType)">
                        <i class="bi bi-check-circle"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label">🌍 Last Validated (UTC)</label>
                <input class="form-control bg-light" value="@FormatUtc(_vm.Organization.TaxLastValidated)" readonly />
            </div>
            <div class="col-md-2">
                <label class="form-label">🕒 Last Validated (Local)</label>
                <input class="form-control bg-light" value="@FormatLocalBrowser(_vm.Organization.TaxLastValidated)" readonly />
            </div>
        </div>
    </div>

    <!-- Physical Address -->
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span>Physical Address</span>

            <button
                type="button"
                class="btn btn-sm btn-outline-secondary"
                @onclick="TogglePhysicalAddressReadOnly">
                @if (_isPhysicalAddressReadOnly)
                {
                    <span>Edit</span>
                }
                else
                {
                    <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                }
            </button>
        </div>

        <div class="card-body row g-3">
            <div class="col-md-4">
                <label class="form-label">Address Line 1</label>
                <InputText
                    class="@($"form-control {(_isPhysicalAddressReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.AddressLine1"
                    readonly="@_isPhysicalAddressReadOnly">
                </InputText>
            </div>

            <div class="col-md-4">
                <label class="form-label">Address Line 2</label>
                <InputText
                    class="@($"form-control {(_isPhysicalAddressReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.AddressLine2"
                    readonly="@_isPhysicalAddressReadOnly">
                </InputText>
            </div>

            <div class="col-md-4">
                <label class="form-label">Address Line 3</label>
                <InputText
                    class="@($"form-control {(_isPhysicalAddressReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.AddressLine3"
                    readonly="@_isPhysicalAddressReadOnly">
                </InputText>
            </div>

            <div class="col-md-3">
                <label class="form-label">City</label>
                <InputText
                    class="@($"form-control {(_isPhysicalAddressReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.City"
                    readonly="@_isPhysicalAddressReadOnly">
                </InputText>
            </div>

            <div class="col-md-3">
                <label class="form-label">State/Province</label>
                <InputText
                    class="@($"form-control {(_isPhysicalAddressReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.State"
                    readonly="@_isPhysicalAddressReadOnly">
                </InputText>
            </div>

            <div class="col-md-3">
                <label class="form-label">Postal Code</label>
                <InputText
                    class="@($"form-control {(_isPhysicalAddressReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.PostalCode"
                    readonly="@_isPhysicalAddressReadOnly">
                </InputText>
            </div>

            <div class="col-md-3">
                <label class="form-label" for="addressCountry">Country</label>
                <InputSelect
                    id="addressCountry"
                    class="@($"form-select {(_isPhysicalAddressReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.Country"
                    disabled="@_isPhysicalAddressReadOnly">
                    @foreach (string c in _countryOptions)
                    {
                        <option value="@c">@c</option>
                    }
                </InputSelect>
            </div>
        </div>
    </div>

    <!-- Mailing Address -->
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span>Mailing Address</span>

            <div class="btn-group">
                <button
                    type="button"
                    class="btn btn-sm btn-outline-secondary"
                    disabled="@_isMailingAddressReadOnly"
                    @onclick="CopyPhysicalToMailing">
                    Copy from Physical
                </button>

                <button
                    type="button"
                    class="btn btn-sm btn-outline-secondary"
                    @onclick="ToggleMailingAddressReadOnly">
                    @if (_isMailingAddressReadOnly)
                    {
                        <span>Edit</span>
                    }
                    else
                    {
                        <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                    }
                </button>
            </div>
        </div>

        <div class="card-body row g-3">
            <div class="col-md-4">
                <label class="form-label">Address Line 1</label>
                <InputText
                    class="@($"form-control {(_isMailingAddressReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.MailingAddressLine1"
                    readonly="@_isMailingAddressReadOnly">
                </InputText>
            </div>

            <div class="col-md-4">
                <label class="form-label">Address Line 2</label>
                <InputText
                    class="@($"form-control {(_isMailingAddressReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.MailingAddressLine2"
                    readonly="@_isMailingAddressReadOnly">
                </InputText>
            </div>

            <div class="col-md-4">
                <label class="form-label">Address Line 3</label>
                <InputText
                    class="@($"form-control {(_isMailingAddressReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.MailingAddressLine3"
                    readonly="@_isMailingAddressReadOnly">
                </InputText>
            </div>

            <div class="col-md-3">
                <label class="form-label">City</label>
                <InputText
                    class="@($"form-control {(_isMailingAddressReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.MailingCity"
                    readonly="@_isMailingAddressReadOnly">
                </InputText>
            </div>

            <div class="col-md-3">
                <label class="form-label">State/Province</label>
                <InputText
                    class="@($"form-control {(_isMailingAddressReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.MailingState"
                    readonly="@_isMailingAddressReadOnly">
                </InputText>
            </div>

            <div class="col-md-3">
                <label class="form-label">Postal Code</label>
                <InputText
                    class="@($"form-control {(_isMailingAddressReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.MailingPostalCode"
                    readonly="@_isMailingAddressReadOnly">
                </InputText>
            </div>

            <div class="col-md-3">
                <label class="form-label" for="mailingCountry">Country</label>
                <InputSelect
                    id="mailingCountry"
                    class="@($"form-select {(_isMailingAddressReadOnly ? "bg-light" : "")}")"
                    @bind-Value="_vm.Organization.MailingCountry"
                    disabled="@_isMailingAddressReadOnly">
                    @foreach (string c in _countryOptions)
                    {
                        <option value="@c">@c</option>
                    }
                </InputSelect>
            </div>
        </div>
    </div>

    <!-- Contacts -->
    <div class="row">
        <!-- General / Commercial -->
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span>General / Commercial Contact</span>

                    <div class="btn-group">
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary"
                            disabled="@_isContactsReadOnly"
                            @onclick="CopyGeneralContactDownAsync">
                            Copy Down
                        </button>

                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="ToggleContactsReadOnly">
                            @if (_isContactsReadOnly)
                            {
                                <span>Edit</span>
                            }
                            else
                            {
                                <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                            }
                        </button>
                    </div>
                </div>

                <div class="card-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label">First Name</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.ContactPersonFirstName"
                                readonly="@_isContactsReadOnly" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Last Name</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.ContactPersonLastName"
                                readonly="@_isContactsReadOnly" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">CC</label>
                        <InputSelect class="@($"form-select {(_isContactsReadOnly ? "bg-light" : "")}")"
                                    @bind-Value="_vm.Organization.ContactPersonCountryCode"
                                    disabled="@_isContactsReadOnly">
                            @foreach (string i in _iddOptions)
                            {
                                <option value="@i">@i</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label">Phone</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.ContactPersonPhone"
                                readonly="@_isContactsReadOnly" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Email</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.ContactPersonEmail"
                                readonly="@_isContactsReadOnly" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Job Title</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.ContactPersonJobTitle"
                                readonly="@_isContactsReadOnly" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Billing -->
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span>Billing Contact</span>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            disabled="@_isContactsReadOnly"
                            @onclick="CopyFromGeneralContactToBillingAsync">
                        Copy from General
                    </button>
                </div>

                <div class="card-body row g-3">
                    <div class="col-md-6"><label class="form-label">First Name</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.BillingPersonFirstName"
                                readonly="@_isContactsReadOnly" />
                    </div>

                    <div class="col-md-6"><label class="form-label">Last Name</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.BillingPersonLastName"
                                readonly="@_isContactsReadOnly" />
                    </div>

                    <div class="col-md-4"><label class="form-label">CC</label>
                        <InputSelect class="@($"form-select {(_isContactsReadOnly ? "bg-light" : "")}")"
                                    @bind-Value="_vm.Organization.BillingPersonCountryCode"
                                    disabled="@_isContactsReadOnly">
                            @foreach (string i in _iddOptions)
                            {
                                <option value="@i">@i</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-8"><label class="form-label">Phone</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.BillingPersonPhone"
                                readonly="@_isContactsReadOnly" />
                    </div>

                    <div class="col-12"><label class="form-label">Email</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.BillingPersonEmail"
                                readonly="@_isContactsReadOnly" />
                    </div>

                    <div class="col-12"><label class="form-label">Job Title</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.BillingPersonJobTitle"
                                readonly="@_isContactsReadOnly" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Admin / Technical -->
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span>Admin / Technical Contact</span>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            disabled="@_isContactsReadOnly"
                            @onclick="CopyFromGeneralContactToAdminAsync">
                        Copy from General
                    </button>
                </div>

                <div class="card-body row g-3">
                    <div class="col-md-6"><label class="form-label">First Name</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.AdminPersonFirstName"
                                readonly="@_isContactsReadOnly" />
                    </div>

                    <div class="col-md-6"><label class="form-label">Last Name</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.AdminPersonLastName"
                                readonly="@_isContactsReadOnly" />
                    </div>

                    <div class="col-md-4"><label class="form-label">CC</label>
                        <InputSelect class="@($"form-select {(_isContactsReadOnly ? "bg-light" : "")}")"
                                    @bind-Value="_vm.Organization.AdminPersonCountryCode"
                                    disabled="@_isContactsReadOnly">
                            @foreach (string i in _iddOptions)
                            {
                                <option value="@i">@i</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-8"><label class="form-label">Phone</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.AdminPersonPhone"
                                readonly="@_isContactsReadOnly" />
                    </div>

                    <div class="col-12"><label class="form-label">Email</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.AdminPersonEmail"
                                readonly="@_isContactsReadOnly" />
                    </div>

                    <div class="col-12"><label class="form-label">Job Title</label>
                        <InputText class="@($"form-control {(_isContactsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.Organization.AdminPersonJobTitle"
                                readonly="@_isContactsReadOnly" />
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Domains -->
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span>Tenant Domains</span>

            <button
                type="button"
                class="btn btn-sm btn-outline-secondary"
                @onclick="ToggleDomainsReadOnly">
                @if (_isDomainsReadOnly)
                {
                    <span>Edit</span>
                }
                else
                {
                    <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                }
            </button>
