@page "/platform/users/{id}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AppPolicies.PlatformPolicy.AdminArea)]

@using Cinturon360.Shared.Auth
@using Cinturon360.Shared.Data
@using Cinturon360.Shared.Models.Kernel.Platform
@using Cinturon360.Shared.Models.Static
@using Cinturon360.Shared.Models.Static.Geography
@using Cinturon360.Shared.Models.Static.Identity
@using Cinturon360.Shared.Models.Static.Platform
@using Cinturon360.Shared.Models.Static.System.SysVar
@using Cinturon360.Shared.Models.Static.Travel
@using Cinturon360.Shared.Services.Interfaces.Kernel
@using Cinturon360.Shared.Services.Interfaces.Platform
@using Cinturon360.Web.Components.Shared
@using System.Security.Claims

@inject AuthenticationStateProvider AuthStateProvider
@inject IAdminUserServiceUnified UserSvc
@inject IAdminOrgServiceUnified OrgSvc
@inject NavigationManager Nav
@inject ILoggerService _log


@{ ApplicationUser? U = _vm.User!; }

<PageTitle>Edit User</PageTitle>

@if (_vm.LoadError is not null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@_vm.LoadError</div>
}
else if (_vm.IsLoading)
{
    <div class="alert alert-light border d-inline-flex align-items-center">
        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        Loading user…
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_topBanner))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @_topBanner
            <button type="button" class="btn-close" aria-label="Close" @onclick="() => _topBanner = null"></button>
        </div>
    }

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Edit User</h2>
        <div class="btn-group">
            <button type="button" class="btn btn-outline-secondary" @onclick="BackButton">Back</button>
            <button type="submit" class="btn btn-primary" form="user-edit-form" disabled="@_vm.IsSaving">
                @if (_vm.IsSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                Save
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_vm.Toast))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@_vm.Toast
            <button type="button" class="btn-close" @onclick="() => _vm.Toast = string.Empty" aria-label="Close"></button>
        </div>
    }

    <EditForm id="user-edit-form" Model="_vm.User" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <Microsoft.AspNetCore.Components.Forms.ValidationSummary />

        <div class="row g-3">
            <!-- Account / Status -->
            <div class="col-12">
                <div class="card mb-3">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span>Identity</span>

                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="ToggleAccountReadOnly">
                            @if (_isAccountReadOnly)
                            {
                                <span>Edit</span>
                            }
                            else
                            {
                                <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                            }
                        </button>
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Email/Login</label>
                            <InputText
                                class="@($"form-control {(_isAccountReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.User.Email"
                                readonly="@_isAccountReadOnly">
                            </InputText>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">User Category</label>
                            <InputSelect
                                class="@($"form-select {(_isAccountReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.User.UserCategory"
                                disabled="@_isAccountReadOnly">
                                @foreach (UserCategoryType cat in Enum.GetValues<UserCategoryType>())
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@(_vm.User.IsActive ? "Active" : "Inactive")</label>
                            <div class="form-check form-switch mt-2">
                                <InputCheckbox
                                    class="form-check-input"
                                    @bind-Value="_vm.User.IsActive"
                                    disabled="@_isAccountReadOnly" />
                                <label class="form-check-label" title="@(_vm.User.IsActive ? "Active" : "Inactive")">
                                    <span aria-hidden="true">@(_vm.User.IsActive ? " ✅" : " ❌")</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Organization -->
            <div class="col-12">
                <div class="card mb-3">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span>Organization</span>

                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="ToggleOrganizationReadOnly">
                            @if (_isOrganizationReadOnly)
                            {
                                <span>Edit</span>
                            }
                            else
                            {
                                <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                            }
                        </button>
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Organization</label>
                            <InputSelect
                                class="@($"form-select {(_isOrganizationReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.User.OrganizationId"
                                disabled="@_isOrganizationReadOnly">
                                <option value="">— No org —</option>
                                @foreach (IAdminOrgServiceUnified.OrganizationPickerDto o in _vm.Orgs)
                                {
                                    <option value="@o.Id">@o.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Department</label>
                            <InputText
                                class="@($"form-control {(_isOrganizationReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.User.Department"
                                readonly="@_isOrganizationReadOnly">
                            </InputText>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Cost Centre</label>
                            <InputText
                                class="@($"form-control {(_isOrganizationReadOnly ? "bg-light" : "")}")"
                                @bind-Value="_vm.User.CostCentre"
                                readonly="@_isOrganizationReadOnly">
                            </InputText>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Manager</label>
                            <div class="input-group">
                                <InputText
                                    class="@($"form-control {(_isOrganizationReadOnly ? "bg-light" : "")}")"
                                    Value="@ManagerDisplay"
                                    ValueExpression="@(() => ManagerDisplay)"
                                    readonly />

                                <button
                                    type="button"
                                    class="btn btn-outline-secondary"
                                    disabled="@_isOrganizationReadOnly"
                                    @onclick="OpenManagerPickerAsync">
                                    <i class="bi bi-person-add" aria-hidden="true"></i>
                                    <span class="ms-1">Assign</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Names / Profile -->
            <div class="col-12">
                <div class="card mb-3">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span>Profile</span>
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="ToggleProfileReadOnly">
                            @if (_isProfileReadOnly)
                            {
                                <span>Edit</span>
                            }
                            else
                            {
                                <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                            }
                        </button>
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-md-4">
                            <label class="form-label">First Name</label>
                            <InputText
                                class="@($"form-control {(_isProfileReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.FirstName"
                                readonly="@_isProfileReadOnly">
                            </InputText>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Middle Name</label>
                            <InputText
                                class="@($"form-control {(_isProfileReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.MiddleName"
                                readonly="@_isProfileReadOnly">
                            </InputText>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Last Name</label>
                            <InputText
                                class="@($"form-control {(_isProfileReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.LastName"
                                readonly="@_isProfileReadOnly">
                            </InputText>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Display Name</label>
                            <InputText
                                class="@($"form-control {(_isProfileReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.DisplayName"
                                readonly="@_isProfileReadOnly">
                            </InputText>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Preferred Culture</label>
                            <InputSelect
                                id="preferredCultureSelect"
                                class="@($"form-select {(_isProfileReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.PreferredCulture"
                                disabled="@_isProfileReadOnly">
                                @foreach ((string Tag, string Label) c in CulturesType.Bcp47)
                                {
                                    <option value="@c.Tag">@c.Label</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PII & Travel-docs -->
            <div class="col-12">
                <div class="card mb-3">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span>PII & Travel Documents</span>
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="TogglePIITravelDocumentsReadOnly">
                            @if (_isPIITravelDocumentsReadOnly)
                            {
                                <span>Edit</span>
                            }
                            else
                            {
                                <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                            }
                        </button>
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Date of Birth</label>
                            <InputDate
                                class="@($"form-control {(_isPIITravelDocumentsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.DateOfBirth"
                                disabled="@_isPIITravelDocumentsReadOnly" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Passport Country</label>
                            <InputSelect class="@($"form-select {(_isPIITravelDocumentsReadOnly ? "bg-light" : "")}")"
                                        @bind-Value="U.CountryOfIssue"
                                        disabled="@_isPIITravelDocumentsReadOnly">

                                @foreach (var c in PassportCountries.All)
                                {
                                    <option value="@c.Code">@c.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Passport Expiry</label>
                            <InputDate
                                class="@($"form-control {(_isPIITravelDocumentsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.PassportExpirationDate"
                                disabled="@_isPIITravelDocumentsReadOnly" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Gender</label>
                            <InputSelect
                                class="@($"form-select {(_isPIITravelDocumentsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.Gender"
                                disabled="@_isPIITravelDocumentsReadOnly">
                                @foreach (GenderType g in Enum.GetValues<GenderType>())
                                {
                                    <option value="@g">@g</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Flight Preferences -->
            <div class="col-12">
                <div class="card mb-3">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span>Flight Preferences</span>
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="ToggleFlightPreferencesReadOnly">
                            @if (_isFlightPreferencesReadOnly)
                            {
                                <span>Edit</span>
                            }
                            else
                            {
                                <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                            }
                        </button>
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Origin Location (IATA)</label>
                            <InputText
                                class="@($"form-control {(_isFlightPreferencesReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.OriginLocationCode"
                                readonly="@_isFlightPreferencesReadOnly">
                            </InputText>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Default Flight Seating</label>
                           <InputSelect
                                class="@($"form-select {(_isFlightPreferencesReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.DefaultFlightSeating"
                                disabled="@_isFlightPreferencesReadOnly">

                                @foreach (var o in FareType.DropdownOptions)
                                {
                                    <option value="@o.Code">@o.Label</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Max Flight Seating</label>
                            <InputSelect
                                class="@($"form-select {(_isFlightPreferencesReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.MaxFlightSeating"
                                disabled="@_isFlightPreferencesReadOnly">

                                @foreach (var o in FareType.DropdownOptions)
                                {
                                    <option value="@o.Code">@o.Label</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Cabin Class Coverage</label>
                            <InputSelect
                                class="@($"form-select {(_isFlightPreferencesReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.CabinClassCoverage"
                                isabled="@_isFlightPreferencesReadOnly">

                                @foreach (var o in FareType.DropdownOptions)
                                {
                                    <option value="@o.Code">@o.Label</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Non-stop Flights</label>
                            <InputSelect
                                class="@($"form-select {(_isFlightPreferencesReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.NonStopFlight"
                                disabled="@_isFlightPreferencesReadOnly">

                                <option value="">Unset</option>
                                <option value="false">No</option>
                                <option value="true">Yes</option>

                            </InputSelect>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Booking Lead Days</label>
                            <InputNumber
                                class="@($"form-control {(_isFlightPreferencesReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.DefaultCalendarDaysInAdvanceForFlightBooking"
                                disabled="@_isFlightPreferencesReadOnly" />
                        </div>

                        <div class="col-md-9">
                            <label class="form-label">Included Airline Codes (one per line)</label>
                            <textarea
                                class="@($"form-control {(_isFlightPreferencesReadOnly ? "bg-light" : "")}")"
                                rows="4"
                                @bind="_vm.IncludedAirlineCodesText"
                                readonly="@_isFlightPreferencesReadOnly">
                            </textarea>
                        </div>
                        <div class="col-md-9">
                            <label class="form-label">Excluded Airline Codes (one per line)</label>
                            <textarea
                                class="@($"form-control {(_isFlightPreferencesReadOnly ? "bg-light" : "")}")"
                                rows="4"
                                @bind="_vm.ExcludedAirlineCodesText"
                                readonly="@_isFlightPreferencesReadOnly">
                            </textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Financial & Limits -->
            <div class="col-12">
                <div class="card mb-3">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span>Financial & Limits</span>
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="ToggleFinancialLimitsReadOnly">
                            @if (_isFinancialLimitsReadOnly)
                            {
                                <span>Edit</span>
                            }
                            else
                            {
                                <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                            }
                        </button>
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Default Currency (ISO 4217)</label>
                            <InputText
                                class="@($"form-control {(_isFinancialLimitsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.DefaultCurrencyCode"
                                readonly="@_isFinancialLimitsReadOnly">
                            </InputText>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Max Flight Price</label>
                            <InputNumber
                                class="@($"form-control {(_isFinancialLimitsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.MaxFlightPrice"
                                disabled="@_isFinancialLimitsReadOnly" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Max Results</label>
                            <InputNumber
                                class="@($"form-control {(_isFinancialLimitsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.MaxResults"
                                disabled="@_isFinancialLimitsReadOnly" />
                        </div>
                        
                    </div>
                </div>
            </div>

            <!-- Booking Windows -->
            <div class="col-12">
                <div class="card mb-3">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span>Booking Windows</span>
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="ToggleBookingWindowsReadOnly">
                            @if (_isBookingWindowsReadOnly)
                            {
                                <span>Edit</span>
                            }
                            else
                            {
                                <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                            }
                        </button>
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Flights Available From (hh:mm:ss)</label>
                            <InputText
                                class="@($"form-control {(_isBookingWindowsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.FlightBookingTimeAvailableFrom"
                                readonly="@_isBookingWindowsReadOnly" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Flights Available To (hh:mm:ss)</label>
                            <InputText
                                class="@($"form-control {(_isBookingWindowsReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.FlightBookingTimeAvailableTo"
                                readonly="@_isBookingWindowsReadOnly" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Policy Links -->
            <div class="col-12">
                <div class="card mb-3">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span>Policy Links</span>
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="TogglePolicyLinksReadOnly">
                            @if (_isPolicyLinksReadOnly)
                            {
                                <span>Edit</span>
                            }
                            else
                            {
                                <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                            }
                        </button>
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Travel Policy Name</label>
                            <InputText
                                class="@($"form-control {(_isPolicyLinksReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.TravelPolicyName"
                                readonly="@_isPolicyLinksReadOnly" />
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label">Travel Policy Id</label>
                            <InputText
                                class="@($"form-control {(_isPolicyLinksReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.TravelPolicyId"
                                readonly="@_isPolicyLinksReadOnly" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Expense Policy Name</label>
                            <InputText
                                class="@($"form-control {(_isPolicyLinksReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.ExpensePolicyName"
                                readonly="@_isPolicyLinksReadOnly" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Expense Policy Id</label>
                            <InputText
                                class="@($"form-control {(_isPolicyLinksReadOnly ? "bg-light" : "")}")"
                                @bind-Value="U.ExpensePolicyId"
                                readonly="@_isPolicyLinksReadOnly" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Policy Toggles -->
            <div class="col-12">
                <div class="card mb-3">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span>Policy Toggles</span>
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="TogglePolicyTogglesReadOnly">
                            @if (_isPolicyTogglesReadOnly)
                            {
                                <span>Edit</span>
                            }
                            else
                            {
                                <span>Lock <i class="bi bi-lock-fill ms-1"></i></span>
                            }
                        </button>
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Default Flight Seating</label>
                            <div class="form-check form-switch mt-2">
                                <InputCheckbox class="form-check-input"
                                            @bind-Value="U.DefaultFlightSeatingVisible"
                                            disabled="@_isPolicyTogglesReadOnly" />
                                <label class="form-check-label">
                                    <span aria-hidden="true">@(U.DefaultFlightSeatingVisible ? " ✅ Visible" : " ❌ Invisible")</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Max Flight Seating</label>
                            <div class="form-check form-switch mt-2">
                                <InputCheckbox class="form-check-input"
                                            @bind-Value="U.MaxFlightSeatingVisible"
                                            disabled="@_isPolicyTogglesReadOnly" />
                                <label class="form-check-label">
                                    <span aria-hidden="true">@(U.MaxFlightSeatingVisible ? " ✅ Visible" : " ❌ Invisible")</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Cabin Class Coverage</label>
                            <div class="form-check form-switch mt-2">
                                <InputCheckbox class="form-check-input"
                                            @bind-Value="U.CabinClassCoverageVisible"
                                            disabled="@_isPolicyTogglesReadOnly" />
                                <label class="form-check-label">
                                    <span aria-hidden="true">@(U.CabinClassCoverageVisible ? " ✅ Visible" : " ❌ Invisible")</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Airlines Codes</label>
                            <div class="form-check form-switch mt-2">
                                <InputCheckbox class="form-check-input"
                                            @bind-Value="U.AirlineCodesVisible"
                                            disabled="@_isPolicyTogglesReadOnly" />
                                <label class="form-check-label">
                                    <span aria-hidden="true">@(U.AirlineCodesVisible ? " ✅ Visible" : " ❌ Invisible")</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Non-Stop</label>
                            <div class="form-check form-switch mt-2">
                                <InputCheckbox class="form-check-input"
                                            @bind-Value="U.NonStopFlightVisible"
                                            disabled="@_isPolicyTogglesReadOnly" />
                                <label class="form-check-label">
                                    <span aria-hidden="true">@(U.NonStopFlightVisible ? " ✅ Visible" : " ❌ Invisible")</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Default Currency</label>
