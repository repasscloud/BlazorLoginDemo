    }
    private async Task ToggleRolesReadOnly()
    {
        Toggle(ref _isRolesReadOnly);
        await LogUserEditSectionClickedAsync(_userId!, id!, sectionName: "Roles");
    }


    // -----------------
    // Helpers
    // -----------------
    private string ManagerDisplay =>
        _vm.User?.ManagerId is null
            ? "(none)"
            : (_managerDisplay ?? _vm.User.ManagerId);
}
