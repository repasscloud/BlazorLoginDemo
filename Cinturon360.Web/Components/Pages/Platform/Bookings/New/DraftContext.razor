@page "/platform/bookings/context/{bookingType}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Shared:BookingSelect")]

@using System.Security.Claims
@using Cinturon360.Shared.Models.Kernel.SysVar
@using Cinturon360.Shared.Models.Static.System.SysVar
@using Cinturon360.Shared.Services.Interfaces.Kernel
@using Cinturon360.Web.Components.Pages.Platform.Orgs.Policies
@using Microsoft.AspNetCore.Authorization
@using Cinturon360.Shared.Models.Kernel.Platform
@using Cinturon360.Shared.Models.Kernel.Travel
@using Cinturon360.Shared.Models.Static.Platform
@using Cinturon360.Shared.Services.Interfaces.Platform
@using System.Net
@using System.Runtime.InteropServices.Marshalling
@using System.Text.Json;
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Mvc
@using System.Globalization

@inject AuthenticationStateProvider AuthStateProvider
@inject IAdminOrgServiceUnified OrgSvc
@inject IAdminUserServiceUnified UserSvc
@inject IHttpClientFactory HttpClientFactory
@inject ILoggerService LoggerSvc
@inject NavigationManager Nav


@if (Unauthorized)
{
    <div class="alert alert-danger">You are not authorized to access this page.</div>
}
else
{
    @if (ErrorMessage is not null)
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }
    @if (IsSudo)
    {
        <div class="alert alert-warning d-flex align-items-start gap-2">
            <i class="bi bi-shield-lock-fill fs-4"></i>
            <div>
                <strong>SUDO MODE ACTIVE</strong><br />
                You are logged in as a <strong>restricted Sudo account</strong>.
                This account can impersonate any <strong>Vendor</strong>, <strong>TMC</strong>, <strong>Client</strong>, or <strong>User</strong>.
            </div>
        </div>
    }
    else if (IsPlatformUser)
    {
        <div class="alert alert-info d-flex align-items-start gap-2">
            <i class="bi bi-diagram-3-fill fs-4"></i>
            <div>
                <strong>PLATFORM USER CONTEXT</strong><br />
                You are logged in as a <strong>Platform User</strong>.
                The <strong>Vendor</strong> is fixed.
                You may select any <strong>TMC</strong>, <strong>Client</strong>, or <strong>User</strong> within this Vendor.
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info d-flex align-items-start gap-2">
            <i class="bi bi-building-fill fs-4"></i>
            <div>
                <strong>TMC USER CONTEXT</strong><br />
                You are logged in as a <strong>TMC User</strong>.
                The <strong>TMC</strong> is fixed.
                You may select any <strong>Client</strong> or <strong>User</strong> within this TMC.
            </div>
        </div>
    }


    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-9">

                <div class="alert alert-info d-flex align-items-center gap-2 py-2">
                    <i class="bi @GetBookingTypeIcon(BookingTypeNormalized) fs-5"></i>
                    <span>
                        <strong>Booking Type:</strong>
                        @FormatBookingType(BookingTypeNormalized)
                    </span>
                </div>

                @if (IsSudo)
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header"><strong>Select Vendor</strong></div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <div class="input-group">
                                    <select class="form-select" @bind="SelectedVendorId" disabled="@VendorLocked">
                                        <option value="">-- choose --</option>
                                        @foreach (var v in Vendors)
                                        {
                                            <option value="@v.Id">@v.Name</option>
                                        }
                                    </select>
                                    <button class="btn btn-outline-primary" type="button" @onclick="ConfirmVendor" disabled="@VendorLocked">Set</button>
                                </div>
                            </dl>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(SelectedVendorId) && VendorLocked)
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header"><strong>Select TMC</strong></div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <div class="input-group">
                                    <select class="form-select" @bind="SelectedTmcId" disabled="@TmcLocked">
                                        <option value="">-- choose --</option>
                                        @foreach (var t in Tmcs)
                                        {
                                            <option value="@t.Id">@t.Name</option>
                                        }
                                    </select>
                                    <button class="btn btn-outline-primary" type="button" @onclick="ConfirmTmc" disabled="@TmcLocked">Set</button>
                                </div>
                            </dl>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(SelectedTmcId) && TmcLocked)
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header"><strong>Select Client</strong></div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <div class="input-group">
                                    <select class="form-select" @bind="SelectedClientId" disabled="@ClientLocked">
                                        <option value="">-- choose --</option>
                                        @foreach (var c in Clients)
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    </select>
                                    <button class="btn btn-outline-primary" type="button" @onclick="ConfirmClient" disabled="@ClientLocked">Set</button>
                                </div>
                            </dl>
                        </div>
                    </div>
                }
                @if (Users.Any() && ClientLocked)
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header">
                            <strong>Available Users</strong>
                        </div>
                        <div class="card-body">
                            <ul class="list-group">
                                @foreach (var u in Users)
                                {
                                    <li class="list-group-item d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input me-2"
                                            value="@u.UserId"
                                            @onchange="@((ChangeEventArgs e) => ToggleUserSelection(u.UserId, (bool)e.Value!))" />
                                        <span>@u.User.DisplayName (@u.User.Email)</span>
                                    </li>
                                }
                            </ul>

                            <button class="btn btn-primary mt-3" @onclick="CreateQuoteAsync">Continue</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? bookingType { get; set; }
    [SupplyParameterFromQuery(Name = "Tid")] public Guid? Tid { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    private string? orgId;
    private string rid = Guid.NewGuid().ToString(format: "N");

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState? authState = await AuthStateProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal? user = authState.User;

        if (!(user.IsInRole("Sudo") ||
              user.IsInRole("Platform.SuperAdmin") ||
              user.IsInRole("Platform.SuperUser") ||
              user.IsInRole("Platform.Admin") ||
              user.IsInRole("Platform.Support.Admin") ||
              user.IsInRole("Platform.Support.Agent") ||
              user.IsInRole("Tmc.Admin") ||
              user.IsInRole("Tmc.BookingsManager") ||
              user.IsInRole("Tmc.TravelAgent")))
        {
            Unauthorized = true;
            return;
        }

        orgId = user.FindFirst("OrganizationId")?.Value
            ?? user.FindFirst("organizationId")?.Value
            ?? user.FindFirst("org")?.Value;

        IsSudo = user.IsInRole("Sudo");
        IsPlatformUser = user.IsInRole("Platform.SuperAdmin") ||
                         user.IsInRole("Platform.SuperUser") ||
                         user.IsInRole("Platform.Admin") ||
                         user.IsInRole("Platform.Support.Admin") ||
                         user.IsInRole("Platform.Support.Agent");

        if (IsSudo)
        {
            Vendors = (await OrgSvc.SearchAsync(type: OrganizationType.MasterVendor))
                      .Select(a => new IAdminOrgServiceUnified.OrganizationPickerDto
                      {
                          Id = a.Org.Id,
                          Name = a.Org.Name,
                          Type = a.Org.Type,
                          IsActive = a.Org.IsActive
                      }).ToList();
        }
        else if (IsPlatformUser)
        {
            SelectedVendorId = orgId;
            VendorLocked = true;
            await LoadTmcs();
        }
        else if (user.IsInRole("Tmc.Admin") || user.IsInRole("Tmc.BookingsManager") || user.IsInRole("Tmc.TravelAgent"))
        {
            SelectedTmcId = orgId;
            TmcLocked = true;
            await LoadClients();
        }
        else
        {
            SelectedClientId = orgId;
            ClientLocked = true;
            await LoadUsers();
        }

        // assign the currently using user user's id
        myUserId = user.GetUserId();
    }

    private static readonly HashSet<string> AllowedBookingTypes =
        new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "flight", "accomodation", "taxi", "train",
            "hirecar", "bus", "simcard", "activity", "mixed"
        };

    public string BookingTypeNormalized { get; private set; } = string.Empty;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(bookingType) || !AllowedBookingTypes.Contains(bookingType))
        {
            Nav.NavigateTo("/booking/select", forceLoad: true);
            return;
        }

        BookingTypeNormalized = bookingType!.ToLowerInvariant();
    }

    private static string FormatBookingType(string type) => type switch
    {
        "hirecar"      => "Hire Car",
        "simcard"      => "SIM Card",
        "accomodation" => "Accommodation",
        "mixed"        => "Mixed Booking",
        _              => CultureInfo.InvariantCulture.TextInfo
                            .ToTitleCase(type)
    };

    private static string GetBookingTypeIcon(string type) => type switch
    {
        "flight"        => "bi-airplane-fill",
        "accomodation" => "bi-building-fill",
        "taxi"          => "bi-taxi-front-fill",
        "train"         => "bi-train-front-fill",
        "hirecar"       => "bi-car-front-fill",
        "bus"           => "bi-bus-front-fill",
        "simcard"       => "bi-sim-fill",
        "activity"      => "bi-calendar-event-fill",
        "mixed"         => "bi-layers-fill",
        _               => "bi-tag-fill"
    };

    bool Unauthorized;
    bool IsSudo;
    bool IsPlatformUser;

    List<IAdminOrgServiceUnified.OrganizationPickerDto> Vendors = new List<IAdminOrgServiceUnified.OrganizationPickerDto>();
    List<IAdminOrgServiceUnified.OrganizationPickerDto> Tmcs = new List<IAdminOrgServiceUnified.OrganizationPickerDto>();
    List<IAdminOrgServiceUnified.OrganizationPickerDto> Clients = new List<IAdminOrgServiceUnified.OrganizationPickerDto>();
    List<IAdminUserServiceUnified.UserAggregate> Users = new List<IAdminUserServiceUnified.UserAggregate>();

    string? SelectedVendorId;
    string? SelectedTmcId;
    string? SelectedClientId;
    string? myUserId;

    bool VendorLocked;
    bool TmcLocked;
    bool ClientLocked;
    string? ErrorMessage;

    HashSet<string> SelectedUserIds = new HashSet<string>();

    async Task ConfirmVendor()
    {
        if (string.IsNullOrEmpty(SelectedVendorId)) return;
        VendorLocked = true;
        await LoadTmcs();
    }

    async Task ConfirmTmc()
    {
        if (string.IsNullOrEmpty(SelectedTmcId)) return;
        TmcLocked = true;
        await LoadClients();
    }

    async Task ConfirmClient()
    {
        if (string.IsNullOrEmpty(SelectedClientId)) return;
        ClientLocked = true;
        await LoadUsers();
    }

    async Task LoadTmcs()
    {
        Tmcs = (await OrgSvc.SearchAsync(type: OrganizationType.Tmc, parentOrgId: SelectedVendorId))
               .Select(a => new IAdminOrgServiceUnified.OrganizationPickerDto
               {
                   Id = a.Org.Id,
                   Name = a.Org.Name,
                   Type = a.Org.Type,
                   IsActive = a.Org.IsActive
               }).ToList();
    }

    async Task LoadClients()
    {
        Clients = (await OrgSvc.SearchAsync(type: OrganizationType.Client, parentOrgId: SelectedTmcId))
                  .Select(a => new IAdminOrgServiceUnified.OrganizationPickerDto
                  {
                      Id = a.Org.Id,
                      Name = a.Org.Name,
                      Type = a.Org.Type,
                      IsActive = a.Org.IsActive
                  }).ToList();
    }

    async Task LoadUsers()
    {
        Users = (await UserSvc.SearchAsync(organizationId: SelectedClientId)).ToList();
    }

    void ToggleUserSelection(string userId, bool selected)
    {
        if (selected) SelectedUserIds.Add(userId);
        else SelectedUserIds.Remove(userId);
    }

    static readonly JsonSerializerOptions JsonOpts = new JsonSerializerOptions() { PropertyNameCaseInsensitive = true };
    public sealed record ErrorEnvelope(string? Error, string? Rid);
    public sealed record IdEnvelope(string? Id, string? Rid);

    async Task CreateQuoteAsync()
    {
        if (string.IsNullOrEmpty(SelectedClientId) || SelectedUserIds.Count == 0)
            return;

        System.Diagnostics.Stopwatch sw = System.Diagnostics.Stopwatch.StartNew();

        HttpClient client = HttpClientFactory.CreateClient(name: "AvaApi");

        TravelQuoteDto? payload = new TravelQuoteDto
        {
            QuoteType = BookingTypeNormalized,
            CreatedByUserId = myUserId!,
            TmcAssignedId = SelectedTmcId!,
            OrganizationId = SelectedClientId!,
            TravellerUserIds = SelectedUserIds.ToList(),
            Tid = Tid ?? Guid.Empty,
            Uid = myUserId,
            Org = orgId
        };

        using HttpRequestMessage? req = new HttpRequestMessage(HttpMethod.Post, requestUri: "v1/bookings/draft/new")
        {
            Content = JsonContent.Create(payload, options: JsonOpts)
        };

        // Send correlation id to API
        req.Headers.TryAddWithoutValidation(name: "X-Correlation-Id", this.rid);

        // IMPORTANT: send the request you just built (not PostAsJsonAsync on a separate call)
        using HttpResponseMessage? response = await client.SendAsync(req, HttpCompletionOption.ResponseHeadersRead);

        // catch your controller's: return BadRequest(new { error });
        if (response.StatusCode == HttpStatusCode.BadRequest)
        {
            try
            {
                ErrorEnvelope? err = await response.Content.ReadFromJsonAsync<ErrorEnvelope>(JsonOpts);
                ErrorMessage = string.IsNullOrWhiteSpace(err?.Error) ? "Bad request." : err!.Error;
                await LoggerSvc.WarningAsync(
                    evt: SysLogEvtType.API_HTTP_400_BAD_REQUEST,
                    cat: SysLogCatType.Workflow,
                    act: SysLogActionType.Exec,
                    message: "v1/bookings/draft/new",
                    ent: "Platform/Bookings/New/DraftContext",
                    rid: this.rid,
                    tid: Tid,
                    uid: myUserId,
                    org: orgId,
                    durMs: (int)sw.Elapsed.TotalMilliseconds,
                    http: "POST",
                    stat: ((int)response.StatusCode),
                    note: ErrorMessage,
                    overrideOutcome: SysLogOutcome.ERR
                );
            }
            catch
            {
                string raw = await response.Content.ReadAsStringAsync();
                ErrorMessage = string.IsNullOrWhiteSpace(raw) ? "Bad request." : raw;
                await LoggerSvc.WarningAsync(
                    evt: SysLogEvtType.API_HTTP_400_BAD_REQUEST,
                    cat: SysLogCatType.Workflow,
                    act: SysLogActionType.Exec,
                    message: "v1/bookings/draft/new",
                    ent: "Platform/Bookings/New/DraftContext",
                    rid: this.rid,
                    tid: Tid,
                    uid: myUserId,
                    org: orgId,
                    durMs: (int)sw.Elapsed.TotalMilliseconds,
                    http: "POST",
                    stat: ((int)response.StatusCode),
                    note: ErrorMessage,
                    overrideOutcome: SysLogOutcome.ERR
                );
            }
            return;
        }

        // any other non-success → set a terse message and stop
        if (!response.IsSuccessStatusCode)
        {
            string raw = await response.Content.ReadAsStringAsync();
            ErrorMessage = $"HTTP {(int)response.StatusCode} {response.ReasonPhrase}"
                        + (string.IsNullOrWhiteSpace(raw) ? "" : $": {raw}");
            await LoggerSvc.WarningAsync(
                evt: SysLogEvtType.API_HTTP_200_OK,
                cat: SysLogCatType.Workflow,
                act: SysLogActionType.Exec,
                message: "v1/bookings/draft/new",
                ent: "Platform/Bookings/New/DraftContext",
                rid: this.rid,
                tid: Tid,
                uid: myUserId,
                org: orgId,
                durMs: (int)sw.Elapsed.TotalMilliseconds,
                http: "POST",
                stat: ((int)response.StatusCode),
                note: ErrorMessage,
                overrideOutcome: SysLogOutcome.ERR
            );
            return;
        }

        IdEnvelope? ok = await response.Content.ReadFromJsonAsync<IdEnvelope>(JsonOpts);
        if (string.IsNullOrWhiteSpace(ok?.Id))
        {
            ErrorMessage = "Missing ID.";
            await LoggerSvc.WarningAsync(
                evt: SysLogEvtType.API_HTTP_500_INTERNAL_SERVER_ERROR,
                cat: SysLogCatType.Workflow,
                act: SysLogActionType.Exec,
                message: "v1/bookings/draft/new",
                ent: "Platform/Bookings/New/DraftContext",
                rid: this.rid,
                tid: Tid,
                uid: myUserId,
                org: orgId,
                durMs: (int)sw.Elapsed.TotalMilliseconds,
                http: "POST",
                stat: ((int)response.StatusCode),
                note: ErrorMessage,
                overrideOutcome: SysLogOutcome.ERR
            );
            return;
        }

        string? travelQuoteId = ok.Id!;

        string? url =
            $"/platform/bookings/drafts/{Uri.EscapeDataString(travelQuoteId)}/flights/search"
            + (Tid is null ? Guid.Empty.ToString() : $"?tid={Uri.EscapeDataString(Tid.ToString()!)}");

        Nav.NavigateTo(url, forceLoad: true);
    }
}
